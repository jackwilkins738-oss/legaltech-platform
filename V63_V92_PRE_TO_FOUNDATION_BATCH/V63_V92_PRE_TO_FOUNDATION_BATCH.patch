+const ingress=(sub=baseSub(),more={})=>new GraphWebhookIngress({now:()=>NOW,resolveSubscription:async({subscriptionId})=>subscriptionId===SUB?sub:null,...more});
+async function accepted(g,payload={value:[note()]}){const ack=g.receive(payload,{traceId:'trace-1'});assert.equal(ack.status,202);return g.validate(ack.intakeId);}
+
+test('V89 endpoint validation returns the opaque token only as plain text',()=>{const token='<opaque>&token=%2F';assert.deepEqual(graphValidationResponse(token),{status:200,contentType:'text/plain; charset=utf-8',body:token});assert.throws(()=>graphValidationResponse('x'.repeat(4097)),/INVALID/);});
+test('V89 receive acknowledges before notification authenticity validation',async()=>{const g=ingress();const ack=g.receive({value:[note({clientState:'attacker'})]},{traceId:'t'});assert.equal(ack.status,202);await assert.rejects(()=>g.validate(ack.intakeId),/INVALID/);});
+test('V89 internal tenant is resolved from subscription and never trusted from payload',async()=>{const g=ingress();const rows=await accepted(g);assert.equal(rows[0].tenantId,'internal-tenant-a');const bad=ingress();await assert.rejects(()=>accepted(bad,{value:[note({tenantId:'44444444-4444-4444-8444-444444444444'})]}),/INVALID/);});
+test('V89 clientState mismatch fails closed with no validated dispatch',async()=>{await assert.rejects(()=>accepted(ingress(),{value:[note({clientState:'wrong'})]}),/INVALID/);});
+test('V89 unknown inactive and expired subscriptions fail closed',async()=>{await assert.rejects(()=>accepted(new GraphWebhookIngress({now:()=>NOW,resolveSubscription:async()=>null})),/INVALID/);for(const sub of [baseSub({status:'REMOVED'}),baseSub({expiresAt:'2027-05-01T11:59:59Z'})])await assert.rejects(()=>accepted(ingress(sub)),/UNAVAILABLE/);});
