+  const fs=await import('node:fs'),os=await import('node:os'),path=await import('node:path');const {PlatformStore}=await import('../src/store.js');const {LocalObjectStorage}=await import('../src/objectStorage.js');const {DeterministicAIGateway}=await import('../src/aiGateway.js');const {Platform}=await import('../src/platform.js');const {writebackScope}=await import('../src/writeback.js');const dir=fs.mkdtempSync(path.join(os.tmpdir(),'v82-writeback-'));let writes=0;const adapter={async createHistory(){writes++;return {externalWriteId:'should-not-write'};},async getHistory(){return [];}};const store=new PlatformStore(':memory:',{matters:[{id:'ma',tenantId:'ta',externalId:'PA',externalRefs:['CLM-10001']}]});const platform=new Platform({store,objectStorage:new LocalObjectStorage(path.join(dir,'objects')),aiGateway:new DeterministicAIGateway(),proclaim:adapter,securityInterlock:x.registry});
