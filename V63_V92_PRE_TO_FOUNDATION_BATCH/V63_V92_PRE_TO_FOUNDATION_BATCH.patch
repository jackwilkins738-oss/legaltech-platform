+
+test('locked study refuses new observations and estimates',()=>{const x=fixture();try{const locked=x.to.lockStudy({tenantId:'ta',studyId:x.study.id,expectedVersion:1,actorId:'observer',traceId:'lock'});assert.equal(locked.status,'LOCKED');assert.throws(()=>x.to.recordObservation(obs(x.study)),/NOT_OPEN/);assert.throws(()=>x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'X',metric:'STAFF_COUNT',value:1,evidenceType:'ROSTER',confidence:'HIGH',evidenceRef:'EV-1',actorId:'observer',traceId:'e',idempotencyKey:'e'}),/NOT_OPEN/);}finally{x.close();}});
+
+test('analysis separates active waiting blocked context and reactivation time',()=>{const x=fixture();try{x.to.recordObservation(obs(x.study,{idempotencyKey:'1',activeMs:60000}));x.to.recordObservation(obs(x.study,{idempotencyKey:'2',dependency:true,dependencyRoleCode:'CASE_MANAGER',requestType:'QUESTION',waitType:'INTERNAL',activeMs:30000,waitingMs:120000,reactivationMs:60000,contextRetrievalMs:20000,chaseCount:1,blockedMatter:true}));const r=x.to.analyse({tenantId:'ta',studyId:x.study.id});assert.equal(r.totalSamples,2);assert.equal(r.totalActiveMs,90000);assert.equal(r.totalWaitingMs,120000);assert.equal(r.totalBlockedMatterMs,180000);assert.equal(r.totalContextRetrievalMs,30000);assert.equal(r.totalReactivationMs,60000);assert.equal(r.chaseRate,1);assert.equal(r.byRequestType.QUESTION,1);}finally{x.close();}});
+
+test('task-family ranking uses measured burden without treating estimates as measured timing',()=>{const x=fixture();try{x.to.recordObservation(obs(x.study,{idempotencyKey:'1',taskFamily:'A',activeMs:1000}));x.to.recordObservation(obs(x.study,{idempotencyKey:'2',taskFamily:'B',activeMs:100000,sourceType:'INTERVIEW',timingBasis:'ESTIMATED'}));x.to.recordObservation(obs(x.study,{idempotencyKey:'3',taskFamily:'C',activeMs:2000}));const r=x.to.analyse({tenantId:'ta',studyId:x.study.id});assert.equal(r.measuredSamples,2);assert.equal(r.estimatedTimingSamples,1);assert.equal(r.taskFamilies[0].taskFamily,'C');}finally{x.close();}});
+
+test('annualisation refuses fewer than five measured timing samples',()=>{const x=fixture();try{for(let i=0;i<4;i++)x.to.recordObservation(obs(x.study,{idempotencyKey:`o${i}`,activeMs:60000}));x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'INBOUND_CORRESPONDENCE',metric:'FREQUENCY_PER_PERSON_DAY',value:20,evidenceType:'WORKFLOW_LOG',confidence:'HIGH',evidenceRef:'EV-LOG',actorId:'observer',traceId:'f',idempotencyKey:'f'});x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'INBOUND_CORRESPONDENCE',metric:'STAFF_COUNT',value:10,evidenceType:'ROSTER',confidence:'HIGH',evidenceRef:'EV-ROSTER',actorId:'observer',traceId:'s',idempotencyKey:'s'});const a=x.to.annualise({tenantId:'ta',studyId:x.study.id})[0];assert.equal(a.annualisable,false);assert.ok(a.reasons.includes('MINIMUM_MEASURED_TIMING_SAMPLE_NOT_MET'));}finally{x.close();}});
+
+test('annualisation refuses interview-only frequency and headcount estimates',()=>{const x=fixture();try{for(let i=0;i<5;i++)x.to.recordObservation(obs(x.study,{idempotencyKey:`o${i}`,activeMs:60000}));x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'INBOUND_CORRESPONDENCE',metric:'FREQUENCY_PER_PERSON_DAY',value:20,evidenceType:'INTERVIEW',confidence:'HIGH',evidenceRef:'EV-I1',actorId:'observer',traceId:'f',idempotencyKey:'f'});x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'INBOUND_CORRESPONDENCE',metric:'STAFF_COUNT',value:10,evidenceType:'INTERVIEW',confidence:'HIGH',evidenceRef:'EV-I2',actorId:'observer',traceId:'s',idempotencyKey:'s'});const a=x.to.annualise({tenantId:'ta',studyId:x.study.id})[0];assert.equal(a.annualisable,false);assert.deepEqual(a.reasons.sort(),['VALIDATED_FREQUENCY_MISSING','VALIDATED_HEADCOUNT_MISSING'].sort());}finally{x.close();}});
+
+test('validated independent frequency and roster evidence unlock baseline annual exposure',()=>{const x=fixture();try{for(let i=0;i<5;i++)x.to.recordObservation(obs(x.study,{idempotencyKey:`o${i}`,activeMs:60000,dependency:true,dependencyRoleCode:'CASE_MANAGER',requestType:'DECISION',waitType:'INTERNAL',waitingMs:120000,reactivationMs:60000,blockedMatter:true}));x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'INBOUND_CORRESPONDENCE',metric:'FREQUENCY_PER_PERSON_DAY',value:20,evidenceType:'WORKFLOW_LOG',confidence:'HIGH',evidenceRef:'EV-LOG',actorId:'observer',traceId:'f',idempotencyKey:'f'});x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'INBOUND_CORRESPONDENCE',metric:'STAFF_COUNT',value:10,evidenceType:'ROSTER',confidence:'HIGH',evidenceRef:'EV-ROSTER',actorId:'observer',traceId:'s',idempotencyKey:'s'});const a=x.to.annualise({tenantId:'ta',studyId:x.study.id,workingDays:230})[0];assert.equal(a.annualisable,true);assert.equal(a.annualEvents,46000);assert.equal(a.annualActiveHours,766.67);assert.equal(a.annualBlockedMatterHours,2300);assert.equal(a.evidence.frequency.evidenceType,'WORKFLOW_LOG');assert.equal(a.evidence.staff.evidenceType,'ROSTER');}finally{x.close();}});
