+// Security regression concepts: TO field import bounded; TO import PII rejection; TO import idempotency.
+import test from 'node:test';import assert from 'node:assert/strict';import {PlatformStore} from '../src/store.js';import {TOStudy} from '../src/toStudy.js';import {TOFieldIntake,toFieldTemplate,TO_FIELD_COLUMNS} from '../src/toFieldIntake.js';
+const NOW=Date.parse('2027-03-01T12:00:00Z');
+function fixture(){const store=new PlatformStore(':memory:');const studyApi=new TOStudy({store,now:()=>NOW});const study=studyApi.createStudy({tenantId:'ta',studyKey:'WEEK_1',actorId:'observer',traceId:'study',idempotencyKey:'study'});const intake=new TOFieldIntake({study:studyApi});return {store,studyApi,study,intake,close:()=>store.close()};}
+const H=TO_FIELD_COLUMNS;
+function csv(rows){const esc=v=>{const s=String(v??'');return /[",\r\n]/.test(s)?`"${s.replaceAll('"','""')}"`:s;};return `${H.join(',')}\n${rows.map(r=>H.map(k=>esc(r[k]??'')).join(',')).join('\n')}\n`;}
+function observation(over={}){return {record_type:'OBSERVATION',participant_alias:'P-01',matter_alias:'MAT-001',role_code:'LEGAL_ADMIN',task_family:'INBOUND_CORRESPONDENCE',source_type:'DIRECT_OBSERVATION',timing_basis:'MEASURED',observed_at:'2027-02-25T10:00:00Z',active_ms:'60000',waiting_ms:'0',wait_type:'NONE',context_retrieval_ms:'10000',reactivation_ms:'0',systems:'PROCLAIM|OUTLOOK',system_switches:'2',chase_count:'0',rework:'FALSE',dependency:'FALSE',request_type:'NONE',judgement_level:'MECHANICAL',escalated:'FALSE',escalation_depth:'0',blocked_matter:'FALSE',proclaim_capability:'UNKNOWN',...over};}
+function estimate(over={}){return {record_type:'ESTIMATE',task_family:'INBOUND_CORRESPONDENCE',metric:'STAFF_COUNT',value:'10',evidence_type:'ROSTER',confidence:'HIGH',evidence_ref:'EV-ROSTER-1',estimate_observed_at:'2027-02-25T00:00:00Z',...over};}
+
+test('canonical template contains the exact bounded field header',()=>{assert.equal(toFieldTemplate(),`${H.join(',')}\n`);assert.equal(new Set(H).size,H.length);});
