diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/027_graph_subscription_lifecycle.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/027_graph_subscription_lifecycle.sql
