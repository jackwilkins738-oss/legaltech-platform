+
+test('queue order prioritises higher priority then earlier due work',()=>{const x=fixture();try{x.work.createWork(base({idempotencyKey:'1',title:'low',priority:10,dueAt:'2027-01-02T00:00:00.000Z'}));x.work.createWork(base({idempotencyKey:'2',title:'high-later',priority:90,dueAt:'2027-01-03T00:00:00.000Z'}));x.work.createWork(base({idempotencyKey:'3',title:'high-sooner',priority:90,dueAt:'2027-01-01T00:00:00.000Z'}));const q=x.work.listQueue({tenantId:'ta'});assert.deepEqual(q.map(x=>x.title),['high-sooner','high-later','low']);}finally{x.close();}});
