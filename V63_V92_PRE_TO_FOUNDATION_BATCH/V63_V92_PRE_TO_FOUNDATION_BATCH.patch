@@ -0,0 +1,13 @@
+import test from 'node:test';import assert from 'node:assert/strict';import {KeyLifecycleRegistry} from '../src/keyLifecycle.js';
+const fp=n=>String(n).padStart(64,String(n).slice(-1));
+function fx(){const registry=new KeyLifecycleRegistry({authorizeChange:({actorId})=>actorId.startsWith('sec-'),now:()=>Date.parse('2026-10-09T12:00:00Z')});return {registry};}
+const initial=(r,over={})=>r.registerInitial({tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:1,providerKeyFingerprint:'a'.repeat(64),actorId:'sec-a',traceId:'tr1',...over});
+
+test('V87 initial generation is ACTIVE and encryption binding contains metadata only',()=>{const {registry:r}=fx();initial(r);const b=r.encryptionBinding({tenantId:'tenant-a',purpose:'CLIENT_DATA'});assert.deepEqual(Object.keys(b).sort(),['generation','keyAlias','providerKeyFingerprint','purpose','tenantId','version'].sort());assert.equal(b.generation,1);assert.equal(JSON.stringify(b).includes('secret'),false);});
+test('V87 rotation is strictly monotonic and prior generation becomes decrypt-only',()=>{const {registry:r}=fx();initial(r);r.rotate({tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:2,providerKeyFingerprint:'b'.repeat(64),actorId:'sec-a',traceId:'tr2'});assert.equal(r.encryptionBinding({tenantId:'tenant-a',purpose:'CLIENT_DATA'}).generation,2);const rows=r.listPublic('tenant-a','CLIENT_DATA');assert.equal(rows[0].status,'DECRYPT_ONLY');assert.equal(rows[1].status,'ACTIVE');assert.equal(r.assertDecryptBinding({version:1,tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:1,providerKeyFingerprint:'a'.repeat(64)}),true);});
+test('V87 skipped reused or rollback generations fail closed',()=>{const {registry:r}=fx();initial(r);assert.throws(()=>r.rotate({tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:3,providerKeyFingerprint:'c'.repeat(64),actorId:'sec-a',traceId:'x'}),/SEQUENCE/);assert.throws(()=>r.rotate({tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:2,providerKeyFingerprint:'a'.repeat(64),actorId:'sec-a',traceId:'x'}),/FINGERPRINT_REUSE/);});
+test('V87 active generation cannot be retired and retirement requires external evidence hash',()=>{const {registry:r}=fx();initial(r);assert.throws(()=>r.retire({tenantId:'tenant-a',purpose:'CLIENT_DATA',generation:1,actorId:'sec-a',traceId:'x',retirementEvidenceHash:'c'.repeat(64)}),/NOT_RETIRABLE/);r.rotate({tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:2,providerKeyFingerprint:'b'.repeat(64),actorId:'sec-a',traceId:'r'});assert.throws(()=>r.retire({tenantId:'tenant-a',purpose:'CLIENT_DATA',generation:1,actorId:'sec-a',traceId:'x',retirementEvidenceHash:'bad'}),/RETIRE_EVIDENCE/);r.retire({tenantId:'tenant-a',purpose:'CLIENT_DATA',generation:1,actorId:'sec-a',traceId:'x',retirementEvidenceHash:'c'.repeat(64)});assert.throws(()=>r.assertDecryptBinding({version:1,tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:1,providerKeyFingerprint:'a'.repeat(64)}),/DECRYPT_GENERATION_UNAVAILABLE/);});
+test('V87 decrypt binding is tenant purpose alias generation and fingerprint exact',()=>{const {registry:r}=fx();initial(r);for(const change of [{tenantId:'tenant-b'},{purpose:'AUDIT_DATA'},{keyAlias:'other'},{generation:2},{providerKeyFingerprint:'b'.repeat(64)}])assert.throws(()=>r.assertDecryptBinding({version:1,tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:1,providerKeyFingerprint:'a'.repeat(64),...change}),/DECRYPT_GENERATION_UNAVAILABLE|KEY_BINDING_INVALID/);});
+test('V87 tenant and purpose key lifecycles are isolated',()=>{const {registry:r}=fx();initial(r);initial(r,{tenantId:'tenant-b'});initial(r,{purpose:'AUDIT_DATA'});assert.equal(r.encryptionBinding({tenantId:'tenant-a',purpose:'CLIENT_DATA'}).generation,1);assert.equal(r.encryptionBinding({tenantId:'tenant-b',purpose:'CLIENT_DATA'}).generation,1);assert.equal(r.encryptionBinding({tenantId:'tenant-a',purpose:'AUDIT_DATA'}).generation,1);});
+test('V87 unauthorized key metadata change fails closed before state change',()=>{const {registry:r}=fx();assert.throws(()=>initial(r,{actorId:'user-a'}),/KEY_CHANGE_FORBIDDEN/);assert.throws(()=>r.encryptionBinding({tenantId:'tenant-a',purpose:'CLIENT_DATA'}),/ACTIVE_GENERATION_MISSING/);});
+test('V87 key events contain fingerprints and lifecycle metadata but no key material',()=>{const {registry:r}=fx();initial(r);r.rotate({tenantId:'tenant-a',purpose:'CLIENT_DATA',keyAlias:'client-data',generation:2,providerKeyFingerprint:'b'.repeat(64),actorId:'sec-a',traceId:'r'});const text=JSON.stringify(r.listEvents('tenant-a'));assert.match(text,/KEY_GENERATION_ROTATED/);for(const forbidden of ['private_key','client_secret','plaintext_key','key_material'])assert.equal(text.toLowerCase().includes(forbidden),false);});
diff --git a/40_PLATFORM_FOUNDATION_BUILD/test/notificationDeliveryV73.test.js b/40_PLATFORM_FOUNDATION_BUILD/test/notificationDeliveryV73.test.js
new file mode 100644
index 0000000..21335e6
--- /dev/null
+++ b/40_PLATFORM_FOUNDATION_BUILD/test/notificationDeliveryV73.test.js
@@ -0,0 +1,39 @@
+// Security regression concepts: notification delivery containment; notification delivery lease recovery; notification transport redaction; notification delivery event append-only.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {PlatformStore} from '../src/store.js';
+import {NotificationIntents} from '../src/workflowRuntime.js';
+import {NotificationDeliveryWorker} from '../src/notificationDelivery.js';
+
+function fixture({adapters={},timeoutMs=1000}={}){let clock=Date.parse('2027-01-10T12:00:00Z');const store=new PlatformStore(':memory:');const intents=new NotificationIntents({store,now:()=>clock});const worker=new NotificationDeliveryWorker({store,notificationIntents:intents,adapters,leaseMs:1000,timeoutMs,now:()=>clock});return {store,intents,worker,advance:ms=>clock+=ms,now:()=>clock,close:()=>store.close()};}
+function queue(x,{tenantId='ta',channel='IN_APP',id='1',expiresAt=null,recipient={kind:'USER',id:'u1'}}={}){return x.intents.enqueue({tenantId,channel,templateId:'WORK_RESPONSE_TARGET',recipient,objectType:'WORK',objectId:`work-${id}`,dedupeKey:`d-${tenantId}-${id}`,severity:'NORMAL',traceId:`tr-${id}`,expiresAt});}
+
+test('IN_APP delivery is local, bounded and records only a hashed delivery reference',async()=>{const x=fixture();try{const n=queue(x,{}),r=await x.worker.processNext({tenantId:'ta'});assert.equal(r.status,'DELIVERED');assert.match(r.deliveryRefHash,/^[a-f0-9]{64}$/);assert.equal(x.store.getNotificationIntent('ta',n.id).status,'DELIVERED');const events=x.store.listNotificationDeliveryEvents('ta',n.id);assert.equal(events.length,1);assert.equal(events[0].eventType,'DELIVERED');assert.match(events[0].data.deliveryRefHash,/^[a-f0-9]{64}$/);assert.equal(JSON.stringify(events).includes(`local:${n.id}`),false);}finally{x.close();}});
+
+test('TEAMS has no default external adapter and fails through a bounded retry state',async()=>{const x=fixture();try{const n=queue(x,{channel:'TEAMS'}),r=await x.worker.processNext({tenantId:'ta',channel:'TEAMS'});assert.equal(r.error,'NOTIFICATION_DELIVERY_FAILED');assert.equal(x.store.getNotificationIntent('ta',n.id).status,'QUEUED');assert.equal(JSON.stringify(x.store.listNotificationDeliveryEvents('ta',n.id)).includes('ADAPTER_UNAVAILABLE'),false);}finally{x.close();}});
+
+test('external adapter receives only structured template/object references and no arbitrary content or credentials',async()=>{let seen;const adapter={async deliver(envelope){seen=envelope;return {deliveryRef:'teams-message-1'};}};const x=fixture({adapters:{TEAMS:adapter}});try{queue(x,{channel:'TEAMS'});await x.worker.processNext({tenantId:'ta',channel:'TEAMS'});assert.deepEqual(Object.keys(seen).sort(),['channel','notificationId','object','recipient','severity','templateId','tenantId','traceId'].sort());assert.deepEqual(Object.keys(seen.object).sort(),['id','type']);assert.equal(JSON.stringify(seen).match(/title|description|body|secret|token|credential/i),null);assert.equal(Object.isFrozen(seen),true);assert.equal(Object.isFrozen(seen.recipient),true);}finally{x.close();}});
+
+test('adapter cannot smuggle provider secrets or extra result fields into persisted receipt',async()=>{const x=fixture({adapters:{TEAMS:{async deliver(){return {deliveryRef:'msg-1',accessToken:'SECRET'};}}}});try{const n=queue(x,{channel:'TEAMS'});const r=await x.worker.processNext({tenantId:'ta'});assert.equal(r.error,'NOTIFICATION_DELIVERY_FAILED');assert.equal(JSON.stringify(x.store.listNotificationDeliveryEvents('ta',n.id)).includes('SECRET'),false);}finally{x.close();}});
+
+test('raw adapter error text is never persisted',async()=>{const x=fixture({adapters:{TEAMS:{async deliver(){throw new Error('Bearer raw-super-secret-token');}}}});try{const n=queue(x,{channel:'TEAMS'});await x.worker.processNext({tenantId:'ta'});assert.equal(JSON.stringify(x.store.getNotificationIntent('ta',n.id)).includes('raw-super-secret-token'),false);assert.equal(JSON.stringify(x.store.listNotificationDeliveryEvents('ta',n.id)).includes('raw-super-secret-token'),false);assert.equal(JSON.stringify(x.store.listAudits('ta',200)).includes('raw-super-secret-token'),false);}finally{x.close();}});
+
+test('delivery retries are capped and third failed claim becomes DEAD',async()=>{const x=fixture({adapters:{TEAMS:{async deliver(){throw new Error('down');}}}});try{const n=queue(x,{channel:'TEAMS'});for(let i=0;i<3;i++)await x.worker.processNext({tenantId:'ta',channel:'TEAMS'});const stored=x.store.getNotificationIntent('ta',n.id);assert.equal(stored.attempts,3);assert.equal(stored.status,'DEAD');assert.equal(x.store.listNotificationDeliveryEvents('ta',n.id).length,3);}finally{x.close();}});
+
+test('expired SENDING lease is recovered to QUEUED when retry budget remains',()=>{const x=fixture();try{const n=queue(x,{});const claimed=x.intents.claimNext({tenantId:'ta'});assert.equal(claimed.status,'SENDING');x.store.db.prepare("UPDATE notification_intents SET updated_at='2000-01-01T00:00:00.000Z',data_json=json_set(data_json,'$.updatedAt','2000-01-01T00:00:00.000Z') WHERE id=?").run(n.id);assert.equal(x.worker.recoverExpired({tenantId:'ta'}),1);const stored=x.store.getNotificationIntent('ta',n.id);assert.equal(stored.status,'QUEUED');assert.equal(stored.lastError,'NOTIFICATION_LEASE_EXPIRED');}finally{x.close();}});
+
+test('expired SENDING lease at attempt limit becomes DEAD',()=>{const x=fixture();try{const n=queue(x,{});x.store.db.prepare("UPDATE notification_intents SET status='SENDING',attempts=3,updated_at='2000-01-01T00:00:00.000Z',data_json=json_set(json_set(json_set(data_json,'$.status','SENDING'),'$.attempts',3),'$.updatedAt','2000-01-01T00:00:00.000Z') WHERE id=?").run(n.id);assert.equal(x.worker.recoverExpired({tenantId:'ta'}),1);assert.equal(x.store.getNotificationIntent('ta',n.id).status,'DEAD');}finally{x.close();}});
+
+test('expired queued notification is marked DEAD and never delivered',async()=>{const x=fixture();try{const expiresAt=new Date(x.now()+1000).toISOString(),n=queue(x,{expiresAt});x.advance(1001);assert.equal(x.worker.expire({tenantId:'ta'}),1);assert.equal(await x.worker.processNext({tenantId:'ta'}),null);const stored=x.store.getNotificationIntent('ta',n.id);assert.equal(stored.status,'DEAD');assert.equal(stored.lastError,'NOTIFICATION_EXPIRED');}finally{x.close();}});
+
+test('tenant-scoped delivery cannot claim another tenant notification',async()=>{const x=fixture();try{const other=queue(x,{tenantId:'tb',id:'b'}),own=queue(x,{tenantId:'ta',id:'a'});assert.equal((await x.worker.processNext({tenantId:'ta'})).notificationId,own.id);assert.equal(x.store.getNotificationIntent('tb',other.id).status,'QUEUED');}finally{x.close();}});
+
+test('channel-scoped delivery leaves other channel queued',async()=>{const x=fixture({adapters:{TEAMS:{async deliver(e){return {deliveryRef:`t:${e.notificationId}`};}}}});try{const app=queue(x,{id:'app'}),teams=queue(x,{channel:'TEAMS',id:'teams'});assert.equal((await x.worker.processNext({tenantId:'ta',channel:'TEAMS'})).notificationId,teams.id);assert.equal(x.store.getNotificationIntent('ta',app.id).status,'QUEUED');}finally{x.close();}});
+
+test('delivery events are append-only',async()=>{const x=fixture();try{queue(x,{});await x.worker.processNext({tenantId:'ta'});assert.throws(()=>x.store.db.prepare("UPDATE notification_delivery_events SET event_type='EVIL'").run(),/append-only/);assert.throws(()=>x.store.db.prepare('DELETE FROM notification_delivery_events').run(),/append-only/);}finally{x.close();}});
+
+test('adapter timeout is bounded and records only generic failure',async()=>{const adapter={deliver(_e,{signal}){return new Promise((resolve,reject)=>{signal.addEventListener('abort',()=>reject(new Error('private timeout detail')),{once:true});});}};const x=fixture({adapters:{TEAMS:adapter},timeoutMs:100});try{const n=queue(x,{channel:'TEAMS'}),r=await x.worker.processNext({tenantId:'ta'});assert.equal(r.error,'NOTIFICATION_DELIVERY_FAILED');assert.equal(JSON.stringify(x.store.listNotificationDeliveryEvents('ta',n.id)).includes('private timeout detail'),false);}finally{x.close();}});
+
+test('concurrent claim semantics allow one sender only',()=>{const x=fixture();try{queue(x,{});const a=x.intents.claimNext({tenantId:'ta'}),b=x.intents.claimNext({tenantId:'ta'});assert.ok(a);assert.equal(b,null);}finally{x.close();}});
+
+test('delivery worker validates channel and timing bounds',async()=>{const x=fixture();try{await assert.rejects(()=>x.worker.processNext({tenantId:'ta',channel:'EMAIL'}),/CHANNEL_INVALID/);assert.throws(()=>new NotificationDeliveryWorker({store:x.store,notificationIntents:x.intents,leaseMs:999}),/BOUNDS_INVALID/);}finally{x.close();}});
diff --git a/40_PLATFORM_FOUNDATION_BUILD/test/organizationDirectoryV71.test.js b/40_PLATFORM_FOUNDATION_BUILD/test/organizationDirectoryV71.test.js
new file mode 100644
index 0000000..67e5d77
--- /dev/null
+++ b/40_PLATFORM_FOUNDATION_BUILD/test/organizationDirectoryV71.test.js
@@ -0,0 +1,23 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {PlatformStore} from '../src/store.js';import {OrganizationDirectory} from '../src/organizationDirectory.js';import {WorkOrchestrator} from '../src/workOrchestration.js';import {WorkAuthorizer} from '../src/workAuthorization.js';
+const START=Date.parse('2027-03-01T09:00:00Z');
+function session(actor='alice',caps=['work:read:self','work:update:self','work:respond:self','work:create']){return {tenantId:'ta',actorId:actor,roles:[],capabilities:caps,securityZoneIds:[],matterMembershipIds:[],documentAccessRefs:[]};}
+function fixture(){let now=START;const store=new PlatformStore(':memory:',{matters:[{id:'m1',tenantId:'ta',externalId:'1',externalRefs:[]}]});const directory=new OrganizationDirectory({store,now:()=>now});const work=new WorkOrchestrator({store,now:()=>now});const auth=new WorkAuthorizer({store,now:()=>now,membershipResolver:directory});let n=0;const register=(kind='TEAM',ref='claims')=>directory.registerGroup({tenantId:'ta',kind,groupRef:ref,actorId:'admin',traceId:`tg${++n}`,idempotencyKey:`group-${kind}-${ref}-${n}`});const grant=(g={kind:'TEAM',id:'claims'},memberActorId='alice',more={})=>directory.grantMembership({tenantId:'ta',group:g,memberActorId,actorId:'admin',traceId:`tm${++n}`,idempotencyKey:`membership-${memberActorId}-${n}`,...more});const create=(owner,type='TASK')=>work.createWork({tenantId:'ta',matterId:'m1',type,title:'Shared work',requesterId:'requester',owner,idempotencyKey:`work-${++n}`,actorId:'requester',traceId:`tw${n}`});return {store,directory,work,auth,register,grant,create,setNow:v=>now=v,advance:v=>now+=v,close:()=>store.close()};}
+
+test('group registration is tenant scoped and idempotent',()=>{const x=fixture();try{const a=x.directory.registerGroup({tenantId:'ta',kind:'TEAM',groupRef:'claims',actorId:'admin',traceId:'t',idempotencyKey:'same-key'}),b=x.directory.registerGroup({tenantId:'ta',kind:'TEAM',groupRef:'claims',actorId:'admin',traceId:'t2',idempotencyKey:'same-key'});assert.equal(a.id,b.id);assert.equal(b.replayed,true);assert.equal(x.directory.isMember({tenantId:'tb',actorId:'alice',owner:{kind:'TEAM',id:'claims'}}),false);}finally{x.close();}});
+test('same group reference can exist independently as TEAM and POOL',()=>{const x=fixture();try{const a=x.register('TEAM','shared'),b=x.register('POOL','shared');assert.notEqual(a.id,b.id);}finally{x.close();}});
+test('conflicting idempotency and duplicate group registration fail closed',()=>{const x=fixture();try{x.directory.registerGroup({tenantId:'ta',kind:'TEAM',groupRef:'claims',actorId:'admin',traceId:'t',idempotencyKey:'same'});assert.throws(()=>x.directory.registerGroup({tenantId:'ta',kind:'POOL',groupRef:'claims',actorId:'admin',traceId:'t',idempotencyKey:'same'}),/IDEMPOTENCY_CONFLICT/);assert.throws(()=>x.directory.registerGroup({tenantId:'ta',kind:'TEAM',groupRef:'claims',actorId:'admin',traceId:'t',idempotencyKey:'different'}),/GROUP_EXISTS/);}finally{x.close();}});
+test('active trusted TEAM membership grants self work read update respond and create',()=>{const x=fixture();try{x.register();x.grant();const owner={kind:'TEAM',id:'claims'},task=x.create(owner),decision=x.create(owner,'DECISION'),s=session();assert.equal(x.auth.assertRead(s,task.id).id,task.id);assert.equal(x.auth.assertUpdate(s,task.id).id,task.id);assert.equal(x.auth.assertRespond(s,decision.id).id,decision.id);assert.equal(x.auth.assertCreate(s,{matterId:'m1',owner}).owner.id,'claims');}finally{x.close();}});
+test('active trusted POOL membership grants self access through the same boundary',()=>{const x=fixture();try{x.register('POOL','intake');x.grant({kind:'POOL',id:'intake'});const w=x.create({kind:'POOL',id:'intake'});assert.equal(x.auth.assertRead(session(),w.id).id,w.id);}finally{x.close();}});
+test('group identifier matching without membership grants no authority',()=>{const x=fixture();try{x.register();const w=x.create({kind:'TEAM',id:'claims'});assert.throws(()=>x.auth.assertRead(session(),w.id),e=>e.code==='NOT_FOUND');}finally{x.close();}});
+test('membership for a different actor grants no authority',()=>{const x=fixture();try{x.register();x.grant({kind:'TEAM',id:'claims'},'bob');const w=x.create({kind:'TEAM',id:'claims'});assert.throws(()=>x.auth.assertRead(session('alice'),w.id),e=>e.code==='NOT_FOUND');assert.equal(x.auth.assertRead(session('bob'),w.id).id,w.id);}finally{x.close();}});
+test('future membership is inactive until its exact start',()=>{const x=fixture();try{x.register();const future=new Date(START+60_000).toISOString();x.grant({kind:'TEAM',id:'claims'},'alice',{startsAt:future});assert.equal(x.directory.isMember({tenantId:'ta',actorId:'alice',owner:{kind:'TEAM',id:'claims'}}),false);x.advance(60_000);assert.equal(x.directory.isMember({tenantId:'ta',actorId:'alice',owner:{kind:'TEAM',id:'claims'}}),true);}finally{x.close();}});
+test('membership expiry removes access without mutating evidence',()=>{const x=fixture();try{x.register();x.grant({kind:'TEAM',id:'claims'},'alice',{endsAt:new Date(START+60_000).toISOString()});const w=x.create({kind:'TEAM',id:'claims'});assert.equal(x.auth.assertRead(session(),w.id).id,w.id);x.advance(60_000);assert.throws(()=>x.auth.assertRead(session(),w.id),e=>e.code==='NOT_FOUND');}finally{x.close();}});
+test('membership revoke immediately removes work self authority',()=>{const x=fixture();try{x.register();const m=x.grant(),w=x.create({kind:'TEAM',id:'claims'});assert.equal(x.auth.assertRead(session(),w.id).id,w.id);x.directory.revokeMembership({tenantId:'ta',membershipId:m.id,expectedVersion:1,actorId:'admin',traceId:'revoke',reason:'team change'});assert.throws(()=>x.auth.assertRead(session(),w.id),e=>e.code==='NOT_FOUND');}finally{x.close();}});
+test('retiring a group invalidates otherwise active memberships',()=>{const x=fixture();try{const g=x.register();x.grant();assert.equal(x.directory.isMember({tenantId:'ta',actorId:'alice',owner:{kind:'TEAM',id:'claims'}}),true);x.directory.retireGroup({tenantId:'ta',kind:'TEAM',groupRef:'claims',expectedVersion:g.version,actorId:'admin',traceId:'r',reason:'organisation changed'});assert.equal(x.directory.isMember({tenantId:'ta',actorId:'alice',owner:{kind:'TEAM',id:'claims'}}),false);}finally{x.close();}});
+test('overlapping active memberships are rejected but non-overlapping windows are allowed',()=>{const x=fixture();try{x.register();const t1=new Date(START+60_000).toISOString(),t2=new Date(START+120_000).toISOString();x.grant({kind:'TEAM',id:'claims'},'alice',{startsAt:new Date(START).toISOString(),endsAt:t1});assert.throws(()=>x.grant({kind:'TEAM',id:'claims'},'alice',{startsAt:new Date(START+30_000).toISOString(),endsAt:t2}),/MEMBERSHIP_OVERLAP/);assert.ok(x.grant({kind:'TEAM',id:'claims'},'alice',{startsAt:t1,endsAt:t2}));}finally{x.close();}});
+test('cannot grant membership into a missing or retired group',()=>{const x=fixture();try{assert.throws(()=>x.grant(),/GROUP_UNAVAILABLE/);const g=x.register();x.directory.retireGroup({tenantId:'ta',kind:'TEAM',groupRef:'claims',expectedVersion:g.version,actorId:'admin',traceId:'r',reason:'retired group'});assert.throws(()=>x.grant(),/GROUP_UNAVAILABLE/);}finally{x.close();}});
+test('membership revocation is optimistic-version protected',()=>{const x=fixture();try{x.register();const m=x.grant();assert.throws(()=>x.directory.revokeMembership({tenantId:'ta',membershipId:m.id,expectedVersion:99,actorId:'admin',traceId:'r',reason:'change'}),/VERSION_CONFLICT/);}finally{x.close();}});
+test('groupsForActor returns only currently active trusted groups',()=>{const x=fixture();try{x.register('TEAM','a');x.register('POOL','b');x.grant({kind:'TEAM',id:'a'});x.grant({kind:'POOL',id:'b'});assert.deepEqual(x.directory.groupsForActor({tenantId:'ta',actorId:'alice'}).map(g=>`${g.kind}:${g.id}`).sort(),['POOL:b','TEAM:a']);}finally{x.close();}});
+test('directory event ledger is append-only at local boundary',()=>{const x=fixture();try{const g=x.register();const events=x.directory.events({tenantId:'ta',subjectType:'GROUP',subjectId:g.id});assert.equal(events[0].eventType,'GROUP_REGISTERED');assert.throws(()=>x.store.db.prepare("UPDATE org_directory_events SET event_type='EVIL'").run(),/append-only/);assert.throws(()=>x.store.db.prepare('DELETE FROM org_directory_events').run(),/append-only/);}finally{x.close();}});
