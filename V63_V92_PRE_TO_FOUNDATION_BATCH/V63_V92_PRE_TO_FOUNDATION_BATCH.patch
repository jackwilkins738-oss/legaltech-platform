+  CHECK (notification_fingerprint IS NULL OR notification_fingerprint ~ '^[a-f0-9]{64}$'),
+  CHECK (reason_code IS NULL OR (length(reason_code) BETWEEN 1 AND 100 AND reason_code ~ '^[A-Z0-9_]+$'))
