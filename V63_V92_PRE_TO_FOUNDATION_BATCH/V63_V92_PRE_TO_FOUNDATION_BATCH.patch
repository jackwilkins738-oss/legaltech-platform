+// Security regression concepts: policy evaluation version pinning; policy evaluation bounded scan; policy evaluation lease recovery; policy evaluation failure isolation.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {PlatformStore} from '../src/store.js';
+import {WorkOrchestrator} from '../src/workOrchestration.js';
+import {NotificationIntents} from '../src/workflowRuntime.js';
+import {WorkEscalationEngine} from '../src/workEscalation.js';
+import {WorkPolicyWorker,WORK_POLICY_JOB_TYPE} from '../src/workPolicyWorker.js';
+
+function fixture({notifications=null}={}){
+  let clock=Date.parse('2027-01-10T12:00:00Z');
+  const store=new PlatformStore(':memory:',{matters:[{id:'m1',tenantId:'ta',externalId:'A',externalRefs:[]},{id:'mb',tenantId:'tb',externalId:'B',externalRefs:[]}]});
+  const work=new WorkOrchestrator({store,now:()=>clock});
+  const notificationIntents=notifications??new NotificationIntents({store,now:()=>clock});
+  const engine=new WorkEscalationEngine({store,workOrchestrator:work,notificationIntents,now:()=>clock});
+  const worker=new WorkPolicyWorker({store,escalationEngine:engine,leaseMs:1000});
+  return {store,work,notificationIntents,engine,worker,advance:ms=>clock+=ms,close:()=>store.close()};
+}
+const notify=(more={})=>({clock:'CREATED_AT',thresholdMs:0,action:'NOTIFY_OWNER',selector:{types:['DECISION'],states:['READY'],ownerKinds:['USER']},channel:'IN_APP',severity:'NORMAL',...more});
+const esc=(more={})=>({clock:'CREATED_AT',thresholdMs:0,action:'CREATE_ESCALATION',selector:{types:['DECISION'],states:['READY']},target:{kind:'TEAM',id:'supervisors'},...more});
+function publish(x,key='RESP',definition=notify(),name='Response'){const d=x.engine.createDraft({tenantId:'ta',policyKey:key,name,definition,actorId:'ops',traceId:`d:${key}`});return x.engine.publish({tenantId:'ta',policyKey:key,version:d.version,actorId:'ops',traceId:`p:${key}`});}
+function decision(x,i,tenantId='ta',matterId='m1'){return x.work.createRequest({tenantId,matterId,type:'DECISION',title:`Decision ${i}`,requesterId:'admin',owner:{kind:'USER',id:'manager'},idempotencyKey:`d-${tenantId}-${i}`,actorId:'admin',traceId:`d-${i}`});}
+
+test('schedule pins published policy version and hash and replays same idempotency key',()=>{const x=fixture();try{const p=publish(x),a=x.worker.schedule({tenantId:'ta',policyKey:'RESP',batchSize:25,actorId:'ops',traceId:'s',idempotencyKey:'run1'}),b=x.worker.schedule({tenantId:'ta',policyKey:'RESP',batchSize:25,actorId:'ops',traceId:'s2',idempotencyKey:'run1'});assert.equal(a.payload.policyVersion,p.version);assert.equal(a.payload.policyHash,p.definitionHash);assert.equal(a.id,b.id);assert.equal(b.replayed,true);}finally{x.close();}});
+
+test('schedule rejects idempotency reuse with changed request and unavailable policy',()=>{const x=fixture();try{publish(x);x.worker.schedule({tenantId:'ta',policyKey:'RESP',batchSize:25,actorId:'ops',traceId:'s',idempotencyKey:'same'});assert.throws(()=>x.worker.schedule({tenantId:'ta',policyKey:'RESP',batchSize:26,actorId:'ops',traceId:'s',idempotencyKey:'same'}),/IDEMPOTENCY_CONFLICT/);assert.throws(()=>x.worker.schedule({tenantId:'ta',policyKey:'MISSING',actorId:'ops',traceId:'s',idempotencyKey:'x'}),/UNAVAILABLE/);}finally{x.close();}});
+
+test('schedulePublished chooses only the latest published version per policy key',()=>{const x=fixture();try{const p1=publish(x,'A');const d2=x.engine.createDraft({tenantId:'ta',policyKey:'A',name:'A v2',definition:notify(),actorId:'ops',traceId:'d2',basedOnVersion:p1.version});const p2=x.engine.publish({tenantId:'ta',policyKey:'A',version:d2.version,actorId:'ops',traceId:'p2'});publish(x,'B');const jobs=x.worker.schedulePublished({tenantId:'ta',batchSize:10,actorId:'ops',traceId:'run',runKey:'manual-1'});assert.equal(jobs.length,2);assert.deepEqual(jobs.map(j=>[j.payload.policyKey,j.payload.policyVersion]).sort(),[['A',p2.version],['B',1]]);}finally{x.close();}});
+
+test('worker processes bounded pages with continuations and materializes each eligible work once',()=>{const x=fixture();try{publish(x);for(let i=0;i<5;i++)decision(x,i);const first=x.worker.schedule({tenantId:'ta',policyKey:'RESP',batchSize:2,actorId:'ops',traceId:'run',idempotencyKey:'r'});const r1=x.worker.processNext({tenantId:'ta'}),r2=x.worker.processNext({tenantId:'ta'}),r3=x.worker.processNext({tenantId:'ta'}),r4=x.worker.processNext({tenantId:'ta'});assert.equal(first.id,r1.jobId);assert.deepEqual([r1.scanned,r2.scanned,r3.scanned],[2,2,1]);assert.equal(r4,null);assert.equal(x.engine.listIntents({tenantId:'ta'}).length,5);assert.equal(x.store.db.prepare("SELECT count(*) n FROM jobs WHERE tenant_id='ta' AND type=? AND status='DONE'").get(WORK_POLICY_JOB_TYPE).n,3);}finally{x.close();}});
+
+test('replaying the same evaluation page deduplicates escalation intents',()=>{const x=fixture();try{publish(x);decision(x,1);const a=x.engine.evaluateBatch({tenantId:'ta',policyKey:'RESP',version:1,actorId:'ops',traceId:'a',limit:10,cursor:0});const b=x.engine.evaluateBatch({tenantId:'ta',policyKey:'RESP',version:1,actorId:'ops',traceId:'b',limit:10,cursor:0});assert.equal(a.intents[0].id,b.intents[0].id);assert.equal(b.intents[0].replayed,true);assert.equal(x.engine.listIntents({tenantId:'ta'}).length,1);}finally{x.close();}});
+
+test('one item notification failure is isolated and does not expose raw provider error',()=>{let base,storeRef;const notifications={enqueue(args){if(args.objectId===base)throw new Error('provider-secret-token-xyz');return new NotificationIntents({store:storeRef}).enqueue(args);}};const x=fixture({notifications});storeRef=x.store;try{publish(x);base=decision(x,1).id;decision(x,2);const r=x.engine.evaluateBatch({tenantId:'ta',policyKey:'RESP',actorId:'ops',traceId:'batch',limit:10,cursor:0});assert.equal(r.eligible,2);assert.equal(r.failed,1);assert.equal(r.intents.length,1);const audits=x.store.listAudits('ta',200).filter(a=>a.action==='WORK_ESCALATION_ITEM_FAILED');assert.equal(audits.length,1);assert.equal(JSON.stringify(audits).includes('provider-secret-token-xyz'),false);}finally{x.close();}});
+
+test('worker refuses to execute a policy retired after scheduling',()=>{const x=fixture();try{const p=publish(x);decision(x,1);const j=x.worker.schedule({tenantId:'ta',policyKey:'RESP',version:p.version,actorId:'ops',traceId:'run',idempotencyKey:'r'});x.engine.retire({tenantId:'ta',policyKey:'RESP',version:p.version,actorId:'ops',traceId:'retire'});const r=x.worker.processNext({tenantId:'ta'});assert.equal(r.jobId,j.id);assert.equal(r.status,'RETRY');assert.equal(x.engine.listIntents({tenantId:'ta'}).length,0);}finally{x.close();}});
+
+test('malformed job payload fails with a bounded generic error',()=>{const x=fixture();try{const j=x.store.enqueue({tenantId:'ta',type:WORK_POLICY_JOB_TYPE,payload:{policyKey:'RESP',policyVersion:1,policyHash:'not-a-hash',cursor:0,batchSize:200,secret:'do-not-log'},traceId:'trace'});const r=x.worker.processNext({tenantId:'ta'});assert.equal(r.jobId,j.id);assert.equal(r.error,'WORK_POLICY_EVALUATION_FAILED');const stored=x.store.getJob(j.id);assert.equal(stored.lastError,'WORK_POLICY_EVALUATION_FAILED');}finally{x.close();}});
+
+test('expired RUNNING policy evaluation lease is recovered and can be reclaimed',()=>{const x=fixture();try{publish(x);const j=x.worker.schedule({tenantId:'ta',policyKey:'RESP',actorId:'ops',traceId:'run',idempotencyKey:'r'});const claimed=x.store.claimNext(WORK_POLICY_JOB_TYPE,'ta');assert.equal(claimed.id,j.id);x.store.db.prepare("UPDATE jobs SET updated_at='2000-01-01T00:00:00.000Z' WHERE id=?").run(j.id);assert.equal(x.worker.recoverExpired({tenantId:'ta'}),1);assert.equal(x.store.getJob(j.id).status,'QUEUED');assert.equal(x.store.claimNext(WORK_POLICY_JOB_TYPE,'ta').id,j.id);}finally{x.close();}});
+
+test('tenant-scoped worker never claims another tenant job',()=>{const x=fixture();try{publish(x);const other=x.store.enqueue({tenantId:'tb',type:WORK_POLICY_JOB_TYPE,payload:{policyKey:'NOPE',policyVersion:1,policyHash:'0'.repeat(64),cursor:0,batchSize:10},traceId:'tb'});const own=x.worker.schedule({tenantId:'ta',policyKey:'RESP',actorId:'ops',traceId:'ta',idempotencyKey:'r'});assert.equal(x.worker.processNext({tenantId:'ta'}).jobId,own.id);assert.equal(x.store.getJob(other.id).status,'QUEUED');}finally{x.close();}});
+
+test('continuation preserves tenant policy pin and hash',()=>{const x=fixture();try{const p=publish(x);for(let i=0;i<3;i++)decision(x,i);const j=x.worker.schedule({tenantId:'ta',policyKey:'RESP',batchSize:2,actorId:'ops',traceId:'run',idempotencyKey:'r'});const r=x.worker.processNext({tenantId:'ta'}),next=x.store.getJob(r.nextJobId);assert.equal(x.store.getJob(j.id).status,'DONE');assert.equal(next.tenantId,'ta');assert.equal(next.payload.policyKey,'RESP');assert.equal(next.payload.policyVersion,p.version);assert.equal(next.payload.policyHash,p.definitionHash);assert.equal(next.payload.cursor,2);}finally{x.close();}});
+
+test('NOTIFY policy produces queue intent only and no external delivery',()=>{const x=fixture();try{publish(x);decision(x,1);x.worker.schedule({tenantId:'ta',policyKey:'RESP',actorId:'ops',traceId:'run',idempotencyKey:'r'});x.worker.processNext({tenantId:'ta'});const row=x.store.db.prepare("SELECT status,channel FROM notification_intents WHERE tenant_id='ta'").get();assert.equal(row.status,'QUEUED');assert.equal(row.channel,'IN_APP');}finally{x.close();}});
+
+test('CREATE_ESCALATION never reassigns the source work item',()=>{const x=fixture();try{publish(x,'ESC',esc());const source=decision(x,1);x.worker.schedule({tenantId:'ta',policyKey:'ESC',actorId:'ops',traceId:'run',idempotencyKey:'r'});x.worker.processNext({tenantId:'ta'});const unchanged=x.work.getWork('ta',source.id),intent=x.engine.listIntents({tenantId:'ta'})[0],created=x.work.getWork('ta',intent.escalationWorkId);assert.deepEqual(unchanged.owner,{kind:'USER',id:'manager'});assert.equal(created.type,'ESCALATION');assert.deepEqual(created.owner,{kind:'TEAM',id:'supervisors'});}finally{x.close();}});
+
+test('batch bounds reject unbounded limits and cursor abuse',()=>{const x=fixture();try{publish(x);for(const [limit,cursor] of [[0,0],[201,0],[1,-1],[1,10001]])assert.throws(()=>x.engine.evaluateBatch({tenantId:'ta',policyKey:'RESP',actorId:'ops',traceId:'x',limit,cursor}),/BATCH_INVALID/);}finally{x.close();}});
+
+test('worker constructor enforces a bounded lease',()=>{const x=fixture();try{assert.throws(()=>new WorkPolicyWorker({store:x.store,escalationEngine:x.engine,leaseMs:999}),/LEASE_INVALID/);assert.throws(()=>new WorkPolicyWorker({store:x.store,escalationEngine:x.engine,leaseMs:1800001}),/LEASE_INVALID/);}finally{x.close();}});
