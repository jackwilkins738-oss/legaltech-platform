+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {PlatformStore} from '../src/store.js';
+import {WorkOrchestrator} from '../src/workOrchestration.js';
+import {WorkAuthorizer,WORK_CAPABILITIES} from '../src/workAuthorization.js';
+
+const NOW=Date.parse('2027-02-01T12:00:00Z');
+function session(more={}){return {tenantId:'ta',actorId:'worker',roles:[],capabilities:[],securityZoneIds:[],matterMembershipIds:[],documentAccessRefs:[],authContext:{method:'SERVER_SESSION',mfaVerified:false,authTime:'2027-02-01T11:59:00Z',expiresAt:'2027-02-01T13:00:00Z',providerSessionId:'sid'},...more};}
+function fixture(){const store=new PlatformStore(':memory:',{matters:[
+  {id:'std',tenantId:'ta',externalId:'STD',externalRefs:[],visibility:'STANDARD'},
+  {id:'private',tenantId:'ta',externalId:'P',externalRefs:[],visibility:'PRIVATE'},
+  {id:'zone',tenantId:'ta',externalId:'Z',externalRefs:[],visibility:'SECURITY_ZONE',securityZoneId:'z-secret'},
+  {id:'other',tenantId:'tb',externalId:'O',externalRefs:[],visibility:'STANDARD'},
+]});const work=new WorkOrchestrator({store,now:()=>NOW});const auth=new WorkAuthorizer({store,now:()=>NOW});let i=0;const create=({matterId='std',owner={kind:'USER',id:'worker'},requesterId='requester',type='TASK'}={})=>work.createWork({tenantId:'ta',matterId,type,title:'Safe work',requesterId,owner,idempotencyKey:`k${++i}`,actorId:requesterId,traceId:`t${i}`});return {store,work,auth,create,close:()=>store.close()};}
+function notFound(fn){assert.throws(fn,e=>e?.code==='NOT_FOUND'&&e?.status===404);}
+
+test('declares a bounded capability vocabulary',()=>{assert.equal(new Set(WORK_CAPABILITIES).size,10);assert.ok(WORK_CAPABILITIES.includes('work:read:self'));assert.ok(WORK_CAPABILITIES.includes('work:policy:manage'));});
+test('self read permits user owner and original requester',()=>{const x=fixture();try{const owned=x.create(),requested=x.create({owner:{kind:'USER',id:'manager'},requesterId:'worker'});const s=session({capabilities:['work:read:self']});assert.equal(x.auth.assertRead(s,owned.id).id,owned.id);assert.equal(x.auth.assertRead(s,requested.id).id,requested.id);}finally{x.close();}});
+test('trusted session role can read role-owned work',()=>{const x=fixture();try{const item=x.create({owner:{kind:'ROLE',id:'case-manager'}});const s=session({roles:['case-manager'],capabilities:['work:read:self']});assert.equal(x.auth.assertRead(s,item.id).id,item.id);}finally{x.close();}});
+test('team and pool ids never create implicit self access',()=>{const x=fixture();try{for(const kind of ['TEAM','POOL']){const item=x.create({owner:{kind,id:'worker'},requesterId:'different'});notFound(()=>x.auth.assertRead(session({capabilities:['work:read:self']}),item.id));}}finally{x.close();}});
+test('read-any never bypasses restricted matter access',()=>{const x=fixture();try{const p=x.create({matterId:'private'}),z=x.create({matterId:'zone'}),s=session({capabilities:['work:read:any']});notFound(()=>x.auth.assertRead(s,p.id));notFound(()=>x.auth.assertRead(s,z.id));assert.equal(x.auth.assertRead(session({capabilities:['work:read:any'],matterMembershipIds:['private']}),p.id).id,p.id);assert.equal(x.auth.assertRead(session({capabilities:['work:read:any'],matterMembershipIds:['zone'],securityZoneIds:['z-secret']}),z.id).id,z.id);}finally{x.close();}});
+test('valid break-glass grant remains matter-bound and time-bound',()=>{const x=fixture();try{const p=x.create({matterId:'private'});const s=session({capabilities:['work:read:any','matter:break_glass'],breakGlassGrants:[{grantId:'g1',matterId:'private',reason:'Urgent client protection',issuedAt:'2027-02-01T11:58:00Z',expiresAt:'2027-02-01T12:05:00Z',stepUpVerified:true}]});assert.equal(x.auth.assertRead(s,p.id).id,p.id);}finally{x.close();}});
+test('cross-tenant work identifiers fail as safe 404',()=>{const x=fixture();try{const foreign=x.work.createWork({tenantId:'tb',matterId:'other',type:'TASK',title:'foreign',requesterId:'x',owner:{kind:'USER',id:'x'},idempotencyKey:'foreign',actorId:'x',traceId:'x'});notFound(()=>x.auth.assertRead(session({capabilities:['work:read:any']}),foreign.id));}finally{x.close();}});
+test('update-self and respond-self require current owner rather than requester',()=>{const x=fixture();try{const task=x.create({owner:{kind:'USER',id:'manager'},requesterId:'worker'}),req=x.create({owner:{kind:'USER',id:'manager'},requesterId:'worker',type:'DECISION'});notFound(()=>x.auth.assertUpdate(session({capabilities:['work:update:self']}),task.id));notFound(()=>x.auth.assertRespond(session({capabilities:['work:respond:self']}),req.id));const manager=session({actorId:'manager',capabilities:['work:update:self','work:respond:self']});assert.equal(x.auth.assertUpdate(manager,task.id).id,task.id);assert.equal(x.auth.assertRespond(manager,req.id).id,req.id);}finally{x.close();}});
+test('any-mutation capability still cannot bypass matter visibility',()=>{const x=fixture();try{const p=x.create({matterId:'private'});notFound(()=>x.auth.assertUpdate(session({capabilities:['work:update:any']}),p.id));notFound(()=>x.auth.assertRespond(session({capabilities:['work:respond:any']}),p.id));}finally{x.close();}});
+test('assignment always requires explicit assignment capability',()=>{const x=fixture();try{const item=x.create();notFound(()=>x.auth.assertAssign(session({capabilities:['work:update:any']}),item.id));assert.equal(x.auth.assertAssign(session({capabilities:['work:assign']}),item.id).id,item.id);}finally{x.close();}});
+test('create to self or trusted role needs create only',()=>{const x=fixture();try{const s=session({roles:['case-manager'],capabilities:['work:create']});assert.equal(x.auth.assertCreate(s,{matterId:'std',owner:{kind:'USER',id:'worker'}}).actorId,'worker');assert.equal(x.auth.assertCreate(s,{matterId:'std',owner:{kind:'ROLE',id:'case-manager'}}).owner.id,'case-manager');}finally{x.close();}});
+test('create for another user, team, pool or untrusted role additionally requires assignment',()=>{const x=fixture();try{const s=session({capabilities:['work:create']});for(const owner of [{kind:'USER',id:'other'},{kind:'TEAM',id:'worker'},{kind:'POOL',id:'worker'},{kind:'ROLE',id:'manager'}])notFound(()=>x.auth.assertCreate(s,{matterId:'std',owner}));const privileged=session({capabilities:['work:create','work:assign']});assert.equal(x.auth.assertCreate(privileged,{matterId:'std',owner:{kind:'TEAM',id:'claims'}}).owner.id,'claims');}finally{x.close();}});
+test('create cannot use inaccessible or foreign matter',()=>{const x=fixture();try{const s=session({capabilities:['work:create']});notFound(()=>x.auth.assertCreate(s,{matterId:'private',owner:{kind:'USER',id:'worker'}}));notFound(()=>x.auth.assertCreate(s,{matterId:'other',owner:{kind:'USER',id:'worker'}}));}finally{x.close();}});
+test('flow intelligence is an explicit privileged capability',()=>{const x=fixture();try{notFound(()=>x.auth.assertFlowRead(session({capabilities:['work:read:any']})));assert.equal(x.auth.assertFlowRead(session({capabilities:['work:flow:read']})).tenantId,'ta');}finally{x.close();}});
+test('response-policy management requires capability and recent MFA by default',()=>{const x=fixture();try{const noStep=session({capabilities:['work:policy:manage']});assert.throws(()=>x.auth.assertPolicyManage(noStep),e=>e?.code==='STEP_UP_REQUIRED');const stepped=session({capabilities:['work:policy:manage'],authContext:{method:'SERVER_SESSION',mfaVerified:true,authTime:'2027-02-01T11:59:00Z',expiresAt:'2027-02-01T13:00:00Z',providerSessionId:'sid'}});assert.equal(x.auth.assertPolicyManage(stepped).actorId,'worker');}finally{x.close();}});
+test('filterReadable applies tenant, matter and self rules to mixed trusted results',()=>{const x=fixture();try{const owned=x.create(),other=x.create({owner:{kind:'USER',id:'manager'},requesterId:'another'}),privateWork=x.create({matterId:'private'});const result=x.auth.filterReadable(session({capabilities:['work:read:self']}),[owned,other,privateWork]);assert.deepEqual(result.map(v=>v.id),[owned.id]);}finally{x.close();}});
