+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {GraphWebhookIngress} from '../src/graphWebhookIngress.js';
+import {GraphWebhookValidationQueue,idempotentGraphDispatch} from '../src/graphWebhookQueue.js';
+
+const SUB='11111111-1111-4111-8111-111111111111',DIR='22222222-2222-4222-8222-222222222222';
+function payload(clientState='secret',id='n1'){return {value:[{id,subscriptionId:SUB,tenantId:DIR,clientState,resource:'/users/a/messages/m1',changeType:'updated',subscriptionExpirationDateTime:'2026-10-09T08:00:00Z'}]};}
+function fixture({resolver=null,handler=null,maxAttempts=3,maxPending=10}={}){let now=Date.parse('2026-10-09T06:00:00Z'),dispatches=[];const ingress=new GraphWebhookIngress({now:()=>now,resolveSubscription:resolver??(async()=>({tenantId:'tenant-a',subscriptionId:SUB,directoryTenantId:DIR,clientState:'secret',status:'ACTIVE',expiresAt:'2026-10-09T08:00:00Z',richData:false,appId:null}))});const dispatch=idempotentGraphDispatch(handler??(async n=>dispatches.push(n)));const queue=new GraphWebhookValidationQueue({ingress,dispatch,now:()=>now,leaseMs:1000,maxAttempts,maxPending});return {queue,ingress,dispatches,advance:ms=>now+=ms};}
+
+test('V91 receipt acknowledges after bounded ephemeral staging and snapshots never expose payload',async()=>{const f=fixture(),r=f.queue.receive(payload(),{traceId:'trace-1'});assert.equal(r.status,202);const view=f.queue.get(r.intakeId);assert.equal(view.status,'QUEUED');assert.equal(JSON.stringify(view).includes('clientState'),false);assert.equal(JSON.stringify(f.queue.events()).includes('/users/'),false);assert.equal(view.payloadHash.length,64);});
+
+test('V91 worker validates then dispatches normalized tenant-bound notification',async()=>{const f=fixture(),r=f.queue.receive(payload(),{traceId:'trace-1'}),done=await f.queue.processNext();assert.equal(done.id,r.intakeId);assert.equal(done.status,'DONE');assert.equal(done.validatedCount,1);assert.equal(done.dispatchCount,1);assert.equal(f.dispatches[0].tenantId,'tenant-a');assert.equal('clientState' in f.dispatches[0],false);assert.equal('resourceData' in f.dispatches[0],false);});
+
+test('V91 invalid authenticity is dead-lettered without retry or dispatch',async()=>{const f=fixture(),r=f.queue.receive(payload('wrong'),{traceId:'trace-1'}),done=await f.queue.processNext();assert.equal(done.status,'DEAD');assert.equal(done.errorCode,'GRAPH_WEBHOOK_VALIDATION_REJECTED');assert.equal(f.dispatches.length,0);assert.equal(f.queue.get(r.intakeId).status,'DEAD');});
+
+test('V91 transient subscription-secret dependency outage is retried then succeeds',async()=>{let fail=true;const f=fixture({resolver:async()=>{if(fail)throw new Error('GRAPH_SUBSCRIPTION_SECRET_UNAVAILABLE');return {tenantId:'tenant-a',subscriptionId:SUB,directoryTenantId:DIR,clientState:'secret',status:'ACTIVE',expiresAt:'2026-10-09T08:00:00Z',richData:false,appId:null};}});f.queue.receive(payload(),{traceId:'trace-1'});let row=await f.queue.processNext();assert.equal(row.status,'QUEUED');assert.equal(row.errorCode,'GRAPH_WEBHOOK_DEPENDENCY_UNAVAILABLE');fail=false;row=await f.queue.processNext();assert.equal(row.status,'DONE');assert.equal(f.dispatches.length,1);});
+
+test('V91 dispatch failure retries same fingerprint and idempotent downstream can complete safely',async()=>{let calls=0,success=[];const f=fixture({handler:async n=>{calls++;if(calls===1)throw new Error('temporary');success.push(n.notificationFingerprint);}});f.queue.receive(payload(),{traceId:'trace-1'});let row=await f.queue.processNext();assert.equal(row.status,'QUEUED');assert.equal(row.errorCode,'GRAPH_WEBHOOK_DISPATCH_FAILED');row=await f.queue.processNext();assert.equal(row.status,'DONE');assert.equal(calls,2);assert.equal(success.length,1);assert.equal(row.duplicateCount,1);});
+
+test('V91 network replay can be presented twice while idempotent dispatch executes business handler once',async()=>{let calls=0;const f=fixture({handler:async()=>{calls++;}});f.queue.receive(payload(),{traceId:'trace-1'});await f.queue.processNext();f.queue.receive(payload(),{traceId:'trace-2'});const second=await f.queue.processNext();assert.equal(second.status,'DONE');assert.equal(second.duplicateCount,1);assert.equal(calls,1);});
+
+test('V91 expired processing lease is recovered and bounded attempts eventually dead-letter',async()=>{const f=fixture({maxAttempts:2}),r=f.queue.receive(payload(),{traceId:'trace-1'});const q=f.queue;const first=q.get(r.intakeId);assert.equal(first.status,'QUEUED');/* claim indirectly via a hanging dependency is unnecessary: use dispatch promise below */
+  let resolve;const p=new Promise(x=>resolve=x);const hanging=fixture({maxAttempts:2,handler:async()=>p});const x=hanging.queue.receive(payload(),{traceId:'trace-x'});const processing=hanging.queue.processNext();await new Promise(x=>setImmediate(x));assert.equal(hanging.queue.get(x.intakeId).status,'RUNNING');hanging.advance(2000);assert.equal(hanging.queue.recoverExpired(),1);assert.equal(hanging.queue.get(x.intakeId).status,'QUEUED');resolve();await processing;});
+
+test('V91 bounded queue capacity refuses overload before acknowledgement',()=>{const f=fixture({maxPending:1});f.queue.receive(payload(),{traceId:'trace-1'});assert.throws(()=>f.queue.receive(payload('secret','n2'),{traceId:'trace-2'}),/GRAPH_WEBHOOK_QUEUE_FULL/);});
+
+test('V91 oversized and malformed callback bodies never enter queue',()=>{const f=fixture();assert.throws(()=>f.queue.receive({value:[]},{traceId:'trace'}),/GRAPH_WEBHOOK_QUEUE_PAYLOAD_INVALID/);assert.throws(()=>f.queue.receive({value:[{x:'x'.repeat(300000)}]},{traceId:'trace'}),/GRAPH_WEBHOOK_QUEUE_PAYLOAD_TOO_LARGE/);assert.equal(f.queue.snapshot().length,0);});
+
+test('V91 dead-letter removes staged payload while retaining bounded hash/state evidence',async()=>{const f=fixture(),r=f.queue.receive(payload('bad'),{traceId:'trace-1'});await f.queue.processNext();const view=f.queue.get(r.intakeId);assert.equal(view.status,'DEAD');assert.equal(JSON.stringify(view).includes('bad'),false);assert.equal(view.payloadHash.length,64);});
+
+test('V91 queue events contain only bounded state/hash/count/error evidence',async()=>{const f=fixture(),r=f.queue.receive(payload(),{traceId:'trace-1'});await f.queue.processNext();const text=JSON.stringify(f.queue.events());assert.equal(text.includes('secret'),false);assert.equal(text.includes('/users/'),false);assert.equal(text.includes(SUB),false);assert.equal(text.includes(r.intakeId),true);});
diff --git a/40_PLATFORM_FOUNDATION_BUILD/test/keyLifecycleV87.test.js b/40_PLATFORM_FOUNDATION_BUILD/test/keyLifecycleV87.test.js
