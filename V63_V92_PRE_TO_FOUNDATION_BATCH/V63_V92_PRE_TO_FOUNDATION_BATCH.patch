+const baseSub=(more={})=>({tenantId:'internal-tenant-a',subscriptionId:SUB,directoryTenantId:DIR,clientState:'very-secret-client-state',status:'ACTIVE',expiresAt:'2027-05-01T13:00:00Z',richData:false,appId:APP,...more});
