+// Security regression concepts: delegation event append-only; flow snapshot append-only; routing cycle protection; blocked-by-owner flow intelligence.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {PlatformStore} from '../src/store.js';
+import {WorkOrchestrator} from '../src/workOrchestration.js';
+import {DelegationDirectory,WorkFlowIntelligence} from '../src/workFlowIntelligence.js';
+
+function fixture(){let clock=Date.parse('2027-01-10T12:00:00Z');const store=new PlatformStore(':memory:',{matters:[{id:'m1',tenantId:'ta',externalId:'A',externalRefs:[]},{id:'m2',tenantId:'ta',externalId:'B',externalRefs:[]},{id:'mx',tenantId:'tb',externalId:'X',externalRefs:[]}]});const work=new WorkOrchestrator({store,now:()=>clock});const routing=new DelegationDirectory({store,now:()=>clock});const flow=new WorkFlowIntelligence({store,now:()=>clock});return {store,work,routing,flow,now:()=>clock,advance:ms=>clock+=ms,close:()=>store.close()};}
+const owner=(id,kind='USER')=>({kind,id});
+const delegation=(more={})=>({tenantId:'ta',principal:owner('u1'),delegate:owner('u2'),startsAt:'2027-01-10T00:00:00Z',endsAt:'2027-01-11T00:00:00Z',reason:'planned absence',actorId:'manager',traceId:'tr',idempotencyKey:'d1',...more});
+const create=(x,key,title='Task',more={})=>x.work.createWork({tenantId:'ta',matterId:'m1',type:'TASK',title,requesterId:'u0',owner:owner('u1'),idempotencyKey:key,actorId:'u0',traceId:`tr-${key}`,...more});
+
+test('delegation grant is idempotent and exact-request bound',()=>{const x=fixture();try{const a=x.routing.grant(delegation()),b=x.routing.grant(delegation());assert.equal(a.id,b.id);assert.equal(b.replayed,true);assert.throws(()=>x.routing.grant(delegation({delegate:owner('u3')})),/IDEMPOTENCY_CONFLICT/);}finally{x.close();}});
+
+test('delegation refuses self delegation and windows longer than ninety days',()=>{const x=fixture();try{assert.throws(()=>x.routing.grant(delegation({delegate:owner('u1')})),/SELF_DELEGATION/);assert.throws(()=>x.routing.grant(delegation({endsAt:'2028-01-11T00:00:00Z'})),/WINDOW_INVALID/);}finally{x.close();}});
+
+test('overlapping active delegation for the same principal fails closed',()=>{const x=fixture();try{x.routing.grant(delegation());assert.throws(()=>x.routing.grant(delegation({delegate:owner('u3'),startsAt:'2027-01-10T06:00:00Z',endsAt:'2027-01-10T18:00:00Z',idempotencyKey:'d2'})),/DELEGATION_OVERLAP/);}finally{x.close();}});
+
+test('owner resolves only inside active delegation window',()=>{const x=fixture();try{x.routing.grant(delegation());assert.equal(x.routing.resolveOwner({tenantId:'ta',owner:owner('u1'),at:'2027-01-09T12:00:00Z'}).resolved.id,'u1');assert.equal(x.routing.resolveOwner({tenantId:'ta',owner:owner('u1'),at:'2027-01-10T12:00:00Z'}).resolved.id,'u2');assert.equal(x.routing.resolveOwner({tenantId:'ta',owner:owner('u1'),at:'2027-01-11T12:00:00Z'}).resolved.id,'u1');}finally{x.close();}});
+
+test('delegation chains resolve deterministically without hard-coding legal roles',()=>{const x=fixture();try{x.routing.grant(delegation());x.routing.grant(delegation({principal:owner('u2'),delegate:owner('u3'),idempotencyKey:'d2'}));const r=x.routing.resolveOwner({tenantId:'ta',owner:owner('u1')});assert.equal(r.resolved.id,'u3');assert.equal(r.delegationIds.length,2);}finally{x.close();}});
+
+test('overlapping delegation cycles are rejected at creation',()=>{const x=fixture();try{x.routing.grant(delegation());assert.throws(()=>x.routing.grant(delegation({principal:owner('u2'),delegate:owner('u1'),idempotencyKey:'d2'})),/DELEGATION_CYCLE/);}finally{x.close();}});
+
+test('revocation is optimistic versioned and immediately stops routing',()=>{const x=fixture();try{const a=x.routing.grant(delegation());assert.throws(()=>x.routing.revoke({tenantId:'ta',delegationId:a.id,expectedVersion:2,actorId:'manager',traceId:'r',reason:'wrong version'}),/VERSION_CONFLICT/);const b=x.routing.revoke({tenantId:'ta',delegationId:a.id,expectedVersion:1,actorId:'manager',traceId:'r',reason:'returned'});assert.equal(b.status,'REVOKED');assert.equal(x.routing.resolveOwner({tenantId:'ta',owner:owner('u1')}).resolved.id,'u1');}finally{x.close();}});
+
+test('delegation lookup is tenant isolated',()=>{const x=fixture();try{x.routing.grant(delegation());assert.equal(x.routing.list({tenantId:'tb'}).length,0);assert.equal(x.routing.resolveOwner({tenantId:'tb',owner:owner('u1')}).resolved.id,'u1');}finally{x.close();}});
+
+test('delegation events are append-only',()=>{const x=fixture();try{x.routing.grant(delegation());assert.throws(()=>x.store.db.prepare("UPDATE delegation_events SET event_type='EVIL'").run(),/append-only/);assert.throws(()=>x.store.db.prepare('DELETE FROM delegation_events').run(),/append-only/);}finally{x.close();}});
+
+test('flow snapshot separates current internal external and blocked waiting',()=>{const x=fixture();try{let a=create(x,'a','Internal'),b=create(x,'b','External'),c=create(x,'c','Blocked');a=x.work.transition({tenantId:'ta',workId:a.id,to:'WAITING_INTERNAL',expectedVersion:1,actorId:'u1',traceId:'a',reason:'internal'});b=x.work.transition({tenantId:'ta',workId:b.id,to:'WAITING_EXTERNAL',expectedVersion:1,actorId:'u1',traceId:'b',reason:'external'});c=x.work.transition({tenantId:'ta',workId:c.id,to:'BLOCKED',expectedVersion:1,actorId:'u1',traceId:'c',reason:'block'});x.advance(10000);const s=x.flow.snapshot({tenantId:'ta'});assert.equal(s.internalWaitMs,10000);assert.equal(s.externalWaitMs,10000);assert.equal(s.blockedWaitMs,10000);assert.equal(s.byState.WAITING_INTERNAL,1);assert.equal(s.byState.WAITING_EXTERNAL,1);assert.equal(s.byState.BLOCKED,1);}finally{x.close();}});
+
+test('blocked-by-owner intelligence counts downstream people and matters rather than messages',()=>{const x=fixture();try{const a=create(x,'a','Admin task',{owner:owner('admin')}),b=create(x,'b','Manager decision',{type:'DECISION',owner:owner('manager')}),c=x.work.createWork({tenantId:'ta',matterId:'m2',type:'TASK',title:'Other admin',requesterId:'u0',owner:owner('admin2'),idempotencyKey:'c',actorId:'u0',traceId:'c'});const d=x.work.createWork({tenantId:'ta',matterId:'m2',type:'QUESTION',title:'Manager question',requesterId:'u0',owner:owner('manager'),idempotencyKey:'d',actorId:'u0',traceId:'d'});x.work.addDependency({tenantId:'ta',workId:a.id,dependsOnWorkId:b.id,expectedVersion:1,actorId:'admin',traceId:'dep1',reason:'decision'});x.work.addDependency({tenantId:'ta',workId:c.id,dependsOnWorkId:d.id,expectedVersion:1,actorId:'admin2',traceId:'dep2',reason:'question'});x.advance(5000);const s=x.flow.snapshot({tenantId:'ta'}),m=s.byOwner.find(v=>v.owner.id==='manager');assert.equal(m.blockedDependents,2);assert.equal(m.blockedMatters,2);assert.equal(m.requestTypes.DECISION,1);assert.equal(m.requestTypes.QUESTION,1);assert.equal(m.oldestBlockedMs,5000);}finally{x.close();}});
+
+test('queue intelligence reports overdue and oldest open age by generic owner',()=>{const x=fixture();try{create(x,'a','Old',{owner:owner('team-a','TEAM'),dueAt:'2027-01-09T00:00:00Z'});x.advance(60000);create(x,'b','New',{owner:owner('team-a','TEAM')});const s=x.flow.snapshot({tenantId:'ta'}),m=s.byOwner.find(v=>v.owner.kind==='TEAM'&&v.owner.id==='team-a');assert.equal(m.openWork,2);assert.equal(m.overdue,1);assert.equal(m.oldestAgeMs,60000);}finally{x.close();}});
+
+test('snapshot response latency and throughput use durable work state',()=>{const x=fixture();try{const q=x.work.createRequest({tenantId:'ta',matterId:'m1',type:'DECISION',title:'Decision',requesterId:'u0',owner:owner('manager'),idempotencyKey:'q',actorId:'u0',traceId:'q'});x.advance(30000);x.work.respond({tenantId:'ta',workId:q.id,expectedVersion:1,actorId:'manager',traceId:'r',outcome:'YES'});const s=x.flow.snapshot({tenantId:'ta',windowStart:'2027-01-10T11:00:00Z'});assert.equal(s.responseCount,1);assert.equal(s.averageResponseLatencyMs,30000);assert.equal(s.completedInWindow,1);}finally{x.close();}});
+
+test('captured snapshots are idempotent append-only aggregate evidence',()=>{const x=fixture();try{create(x,'a');const a=x.flow.capture({tenantId:'ta',actorId:'ops',traceId:'s1',idempotencyKey:'snap1'}),b=x.flow.capture({tenantId:'ta',actorId:'ops',traceId:'s2',idempotencyKey:'snap1'});assert.equal(a.id,b.id);assert.equal(b.replayed,true);assert.equal(JSON.stringify(a).includes('Task'),false);assert.equal(JSON.stringify(a).includes('m1'),false);assert.throws(()=>x.store.db.prepare('DELETE FROM flow_snapshots').run(),/append-only/);}finally{x.close();}});
+
+test('snapshot idempotency key cannot be reused for a different window',()=>{const x=fixture();try{x.flow.capture({tenantId:'ta',actorId:'ops',traceId:'s1',idempotencyKey:'snap1'});assert.throws(()=>x.flow.capture({tenantId:'ta',windowStart:'2027-01-10T00:00:00Z',actorId:'ops',traceId:'s2',idempotencyKey:'snap1'}),/IDEMPOTENCY_CONFLICT/);}finally{x.close();}});
+
+test('snapshot history and comparison expose metric deltas without case content',()=>{const x=fixture();try{let a=create(x,'a');const first=x.flow.capture({tenantId:'ta',actorId:'ops',traceId:'s1',idempotencyKey:'snap1'});a=x.work.transition({tenantId:'ta',workId:a.id,to:'COMPLETED',expectedVersion:1,actorId:'u1',traceId:'done',reason:'done'});const second=x.flow.capture({tenantId:'ta',actorId:'ops',traceId:'s2',idempotencyKey:'snap2'});const c=x.flow.compare({tenantId:'ta',fromSnapshotId:first.id,toSnapshotId:second.id});assert.equal(c.delta.openWork,-1);assert.equal(x.flow.history({tenantId:'ta'}).length,2);}finally{x.close();}});
+
+test('flow snapshots are tenant isolated',()=>{const x=fixture();try{x.flow.capture({tenantId:'ta',actorId:'ops',traceId:'s1',idempotencyKey:'snap1'});assert.equal(x.flow.history({tenantId:'tb'}).length,0);assert.throws(()=>x.flow.compare({tenantId:'tb',fromSnapshotId:'x',toSnapshotId:'y'}),/SNAPSHOT_UNAVAILABLE/);}finally{x.close();}});
