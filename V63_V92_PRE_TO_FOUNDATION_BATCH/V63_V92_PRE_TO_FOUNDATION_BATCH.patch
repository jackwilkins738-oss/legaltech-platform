+
+function fixture(){let now=Date.parse('2026-10-09T08:00:00Z');const store=new PlatformStore(':memory:');const to=new TOStudy({store,now:()=>now});const study=to.createStudy({tenantId:'ta',studyKey:'WEEK_1',actorId:'observer',traceId:'tr-study',idempotencyKey:'study-1'});return {store,to,study,advance:ms=>now+=ms,close:()=>store.close()};}
+const obs=(study,more={})=>({tenantId:'ta',studyId:study.id,participantAlias:'P-001',matterAlias:'MAT-001',roleCode:'LEGAL_ADMIN',taskFamily:'INBOUND_CORRESPONDENCE',sourceType:'DIRECT_OBSERVATION',timingBasis:'MEASURED',observedAt:'2026-10-09T08:05:00Z',activeMs:120000,waitingMs:0,waitType:'NONE',contextRetrievalMs:10000,reactivationMs:0,systems:['PROCLAIM','OUTLOOK'],systemSwitches:2,chaseCount:0,rework:false,dependency:false,requestType:'NONE',judgementLevel:'MECHANICAL',escalated:false,escalationDepth:0,blockedMatter:false,proclaimCapability:'UNKNOWN',actorId:'observer',traceId:'tr-obs',idempotencyKey:'obs-1',...more});
+
+test('study creation is tenant-bound idempotent and duplicate-safe',()=>{const x=fixture();try{const replay=x.to.createStudy({tenantId:'ta',studyKey:'WEEK_1',actorId:'observer',traceId:'x',idempotencyKey:'study-1'});assert.equal(replay.id,x.study.id);assert.equal(replay.replayed,true);assert.throws(()=>x.to.createStudy({tenantId:'ta',studyKey:'OTHER',actorId:'observer',traceId:'x',idempotencyKey:'study-1'}),/IDEMPOTENCY_CONFLICT/);assert.throws(()=>x.to.createStudy({tenantId:'ta',studyKey:'WEEK_1',actorId:'observer',traceId:'x',idempotencyKey:'study-2'}),/KEY_EXISTS/);}finally{x.close();}});
+
+test('observation requires anonymised participant and matter aliases',()=>{const x=fixture();try{assert.throws(()=>x.to.recordObservation(obs(x.study,{participantAlias:'Sarah'})),/PARTICIPANT_ALIAS/);assert.throws(()=>x.to.recordObservation(obs(x.study,{matterAlias:'SMITH-123'})),/MATTER_ALIAS/);}finally{x.close();}});
+
+test('unsafe process notes that look like personal data are refused',()=>{const x=fixture();try{assert.throws(()=>x.to.recordObservation(obs(x.study,{processNote:'Email jane@example.com for the file'})),/PROCESS_NOTE_UNSAFE/);assert.throws(()=>x.to.recordObservation(obs(x.study,{processNote:'Client name appears in source'})),/PROCESS_NOTE_UNSAFE/);}finally{x.close();}});
+
+test('measured timing cannot be sourced from interview evidence',()=>{const x=fixture();try{assert.throws(()=>x.to.recordObservation(obs(x.study,{sourceType:'INTERVIEW'})),/MEASURED_INTERVIEW/);}finally{x.close();}});
+
+test('waiting duration requires an explicit internal or external wait type',()=>{const x=fixture();try{assert.throws(()=>x.to.recordObservation(obs(x.study,{waitingMs:5000})),/WAIT_TYPE_REQUIRED/);const a=x.to.recordObservation(obs(x.study,{waitType:'EXTERNAL',waitingMs:5000}));assert.equal(a.waitType,'EXTERNAL');}finally{x.close();}});
+
+test('dependency fields must be internally consistent',()=>{const x=fixture();try{assert.throws(()=>x.to.recordObservation(obs(x.study,{requestType:'DECISION'})),/DEPENDENCY_FIELDS/);assert.throws(()=>x.to.recordObservation(obs(x.study,{dependency:true,requestType:'DECISION'})),/DEPENDENCY_ROLE_REQUIRED/);assert.throws(()=>x.to.recordObservation(obs(x.study,{dependency:true,dependencyRoleCode:'CASE_MANAGER'})),/REQUEST_TYPE_REQUIRED/);}finally{x.close();}});
+
+test('internal decision dependency captures waiting chase context and reactivation evidence',()=>{const x=fixture();try{const a=x.to.recordObservation(obs(x.study,{dependency:true,dependencyRoleCode:'CASE_MANAGER',requestType:'DECISION',waitType:'INTERNAL',waitingMs:2*60*60*1000,reactivationMs:30*60*1000,contextRetrievalMs:90000,chaseCount:1,blockedMatter:true,judgementLevel:'OPERATIONAL'}));assert.equal(a.requestType,'DECISION');assert.equal(a.chaseCount,1);assert.equal(a.blockedMatter,true);}finally{x.close();}});
+
+test('observation idempotency replays exact evidence and rejects conflicting reuse',()=>{const x=fixture();try{const a=x.to.recordObservation(obs(x.study)),b=x.to.recordObservation(obs(x.study));assert.equal(a.id,b.id);assert.equal(b.replayed,true);assert.throws(()=>x.to.recordObservation(obs(x.study,{activeMs:130000})),/IDEMPOTENCY_CONFLICT/);}finally{x.close();}});
+
+test('corrections supersede rather than mutate prior observation evidence',()=>{const x=fixture();try{const a=x.to.recordObservation(obs(x.study));const b=x.to.recordObservation(obs(x.study,{idempotencyKey:'obs-2',supersedesObservationId:a.id,activeMs:150000}));const all=x.to.observations({tenantId:'ta',studyId:x.study.id,currentOnly:false});const current=x.to.observations({tenantId:'ta',studyId:x.study.id,currentOnly:true});assert.equal(all.length,2);assert.deepEqual(current.map(v=>v.id),[b.id]);assert.throws(()=>x.to.recordObservation(obs(x.study,{idempotencyKey:'obs-3',supersedesObservationId:a.id})),/ALREADY_REPLACED/);}finally{x.close();}});
+
+test('TO observations and estimates are append-only at local storage boundary',()=>{const x=fixture();try{x.to.recordObservation(obs(x.study));x.to.recordEstimate({tenantId:'ta',studyId:x.study.id,taskFamily:'INBOUND_CORRESPONDENCE',metric:'STAFF_COUNT',value:12,evidenceType:'ROSTER',confidence:'HIGH',evidenceRef:'EV-ROSTER-1',actorId:'observer',traceId:'e',idempotencyKey:'e1'});assert.throws(()=>x.store.db.prepare("UPDATE to_observations SET task_family='EVIL'").run(),/append-only/);assert.throws(()=>x.store.db.prepare('DELETE FROM to_estimates').run(),/append-only/);}finally{x.close();}});
+
+
