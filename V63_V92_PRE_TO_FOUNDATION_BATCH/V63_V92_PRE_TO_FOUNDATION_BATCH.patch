+import test from 'node:test';import assert from 'node:assert/strict';
+import {PlatformStore} from '../src/store.js';import {WorkOrchestrator} from '../src/workOrchestration.js';import {WorkAuthorizer} from '../src/workAuthorization.js';import {WorkApiService} from '../src/workApi.js';
+const NOW=Date.parse('2027-02-02T12:00:00Z');
+function ses(m={}){return {tenantId:'ta',actorId:'u1',roles:[],capabilities:[],securityZoneIds:[],matterMembershipIds:[],documentAccessRefs:[],...m};}
+function fixture(){const store=new PlatformStore(':memory:',{matters:[{id:'m1',tenantId:'ta',externalId:'1',externalRefs:[]},{id:'private',tenantId:'ta',externalId:'2',externalRefs:[],visibility:'PRIVATE'}]});const orchestrator=new WorkOrchestrator({store,now:()=>NOW});const authorizer=new WorkAuthorizer({store,now:()=>NOW});const api=new WorkApiService({orchestrator,authorizer});return {store,orchestrator,api,close:()=>store.close()};}
+
+test('create derives tenant requester and actor from trusted session',()=>{const x=fixture();try{const s=ses({capabilities:['work:create']});const w=x.api.create({session:s,input:{matterId:'m1',type:'TASK',title:'A',owner:{kind:'USER',id:'u1'}},idempotencyKey:'idem12345',traceId:'tr1'});assert.equal(w.tenantId,'ta');assert.equal(w.requesterId,'u1');assert.equal(x.orchestrator.events({tenantId:'ta',workId:w.id})[0].actorId,'u1');}finally{x.close();}});
+test('create cannot smuggle inaccessible matter or assignment authority',()=>{const x=fixture();try{assert.throws(()=>x.api.create({session:ses({capabilities:['work:create']}),input:{matterId:'private',title:'x',owner:{kind:'USER',id:'u1'}},idempotencyKey:'abcdefgh',traceId:'t'}),e=>e.code==='NOT_FOUND');assert.throws(()=>x.api.create({session:ses({capabilities:['work:create']}),input:{matterId:'m1',title:'x',owner:{kind:'USER',id:'manager'}},idempotencyKey:'abcdefghi',traceId:'t'}),e=>e.code==='NOT_FOUND');}finally{x.close();}});
+test('get and events enforce same matter-aware read boundary',()=>{const x=fixture();try{const w=x.orchestrator.createWork({tenantId:'ta',matterId:'private',title:'secret',owner:{kind:'USER',id:'u1'},requesterId:'u1',idempotencyKey:'x',actorId:'u1',traceId:'t'});for(const fn of [()=>x.api.get({session:ses({capabilities:['work:read:any']}),workId:w.id}),()=>x.api.events({session:ses({capabilities:['work:read:any']}),workId:w.id})])assert.throws(fn,e=>e.code==='NOT_FOUND');}finally{x.close();}});
+test('list filters unreadable work instead of leaking it',()=>{const x=fixture();try{x.orchestrator.createWork({tenantId:'ta',matterId:'m1',title:'visible',owner:{kind:'USER',id:'u1'},requesterId:'u1',idempotencyKey:'1',actorId:'u1',traceId:'t'});x.orchestrator.createWork({tenantId:'ta',matterId:'private',title:'hidden',owner:{kind:'USER',id:'u1'},requesterId:'u1',idempotencyKey:'2',actorId:'u1',traceId:'t'});const r=x.api.list({session:ses({capabilities:['work:read:self']}),limit:20});assert.deepEqual(r.items.map(v=>v.title),['visible']);}finally{x.close();}});
+test('list cursor is bounded and never returns client-supplied tenant',()=>{const x=fixture();try{assert.throws(()=>x.api.list({session:ses({capabilities:['work:read:any']}),cursor:-1}),e=>e.code==='INVALID_REQUEST');assert.throws(()=>x.api.list({session:ses({capabilities:['work:read:any']}),limit:999}),e=>e.code==='INVALID_REQUEST');}finally{x.close();}});
+test('transition uses current actor and maps stale version to bounded conflict',()=>{const x=fixture();try{const w=x.orchestrator.createWork({tenantId:'ta',matterId:'m1',title:'A',owner:{kind:'USER',id:'u1'},requesterId:'u1',idempotencyKey:'1',actorId:'u1',traceId:'t'});const s=ses({capabilities:['work:update:self']});const started=x.api.transition({session:s,workId:w.id,input:{to:'IN_PROGRESS',expectedVersion:1,reason:'start'},traceId:'api'});assert.equal(started.state,'IN_PROGRESS');assert.throws(()=>x.api.transition({session:s,workId:w.id,input:{to:'COMPLETED',expectedVersion:1,reason:'stale'},traceId:'api2'}),e=>e.code==='WORK_CONFLICT'&&e.status===409);}finally{x.close();}});
+test('respond cannot be performed by requester who is not current owner',()=>{const x=fixture();try{const w=x.orchestrator.createRequest({tenantId:'ta',matterId:'m1',type:'DECISION',title:'D',owner:{kind:'USER',id:'manager'},requesterId:'u1',idempotencyKey:'1',actorId:'u1',traceId:'t'});assert.throws(()=>x.api.respond({session:ses({capabilities:['work:read:self','work:respond:self']}),workId:w.id,input:{expectedVersion:1,outcome:'YES'},traceId:'a'}),e=>e.code==='NOT_FOUND');const done=x.api.respond({session:ses({actorId:'manager',capabilities:['work:respond:self']}),workId:w.id,input:{expectedVersion:1,outcome:'YES'},traceId:'b'});assert.equal(done.response.respondedBy,'manager');}finally{x.close();}});
+test('assign requires explicit assignment capability and preserves actor evidence',()=>{const x=fixture();try{const w=x.orchestrator.createWork({tenantId:'ta',matterId:'m1',title:'A',owner:{kind:'USER',id:'u1'},requesterId:'u1',idempotencyKey:'1',actorId:'u1',traceId:'t'});assert.throws(()=>x.api.assign({session:ses({capabilities:['work:update:any']}),workId:w.id,input:{expectedVersion:1,owner:{kind:'USER',id:'u2'},reason:'x'},traceId:'a'}),e=>e.code==='NOT_FOUND');const moved=x.api.assign({session:ses({capabilities:['work:assign']}),workId:w.id,input:{expectedVersion:1,owner:{kind:'USER',id:'u2'},reason:'handoff'},traceId:'b'});assert.equal(moved.owner.id,'u2');assert.equal(x.orchestrator.events({tenantId:'ta',workId:w.id}).at(-1).actorId,'u1');}finally{x.close();}});
