+import test from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import {PlatformStore} from '../src/store.js';
+import {RecoverySafety,createBackupManifest,validateBackupManifest,backupManifestHash} from '../src/recoverySafety.js';
+import {SecurityMonitor} from '../src/securityMonitoring.js';
+
+const H=seed=>crypto.createHash('sha256').update(seed).digest('hex');
+function manifest(now=Date.now(),more={}){const created=new Date(now-60_000).toISOString();return createBackupManifest({backupId:'b1',tenantId:'ta',backupSetId:'primary-db',generation:1,mode:'PITR',createdAt:created,snapshotAt:created,contentHash:H('content'),storageMode:'IMMUTABLE',immutableUntil:new Date(now+8*86400000).toISOString(),credentialBoundary:'ISOLATED',keyBoundary:'SEPARATE_KMS',kmsKeyRef:'kms://backup/key-v1',...more});}
+function fixture(now=Date.now(),opts={}){const store=new PlatformStore(':memory:');const alerts=[];const monitor=new SecurityMonitor({store,alertSink:{emit:a=>alerts.push(a)}});store.attachSecurityMonitor(monitor);return {store,alerts,recovery:new RecoverySafety({store,now:()=>now,...opts}),close:()=>store.close()};}
+
+test('backup manifests are canonical and tamper evident',()=>{const now=Date.now(),m=manifest(now);assert.equal(backupManifestHash(m),m.manifestHash);assert.equal(validateBackupManifest(m,{tenantId:'ta',now}).backupId,'b1');assert.throws(()=>validateBackupManifest({...m,generation:2},{tenantId:'ta',now}),/TAMPERED/);});
+
+test('backup manifest rejects wrong tenant, stale snapshot and weak boundaries',()=>{const now=Date.now(),m=manifest(now);assert.throws(()=>validateBackupManifest(m,{tenantId:'tb',now}),/TENANT_MISMATCH/);const stale=manifest(now,{backupId:'old',snapshotAt:new Date(now-2*86400000).toISOString(),createdAt:new Date(now-2*86400000).toISOString()});assert.throws(()=>validateBackupManifest(stale,{tenantId:'ta',now}),/RPO/);for(const changed of [{credentialBoundary:'RUNTIME'},{keyBoundary:'SHARED'},{storageMode:'MUTABLE'}]){const x={...m,...changed};x.manifestHash=backupManifestHash(x);assert.throws(()=>validateBackupManifest(x,{tenantId:'ta',now}),/BACKUP_/);}});
+
+test('recording verified backup produces append-only chained evidence and privileged alert',()=>{const now=Date.now(),x=fixture(now);try{const out=x.recovery.recordBackup({manifest:manifest(now),traceId:'tr1',actorId:'backup-service'});assert.equal(out.eventType,'BACKUP_VERIFIED');assert.equal(x.store.verifyRecoveryEvidenceChain('ta'),true);assert.equal(x.alerts.some(a=>a.type==='PRIVILEGED_ACTION'&&a.action==='BACKUP_EVIDENCE_VERIFIED'),true);assert.throws(()=>x.store.db.prepare("DELETE FROM recovery_evidence").run(),/append-only/);}finally{x.close();}});
+
+test('backup generation must advance monotonically within a backup set',()=>{const now=Date.now(),x=fixture(now);try{x.recovery.recordBackup({manifest:manifest(now),traceId:'tr1'});const second=manifest(now,{backupId:'b2',generation:2,contentHash:H('content2')});x.recovery.recordBackup({manifest:second,traceId:'tr2'});const rollback=manifest(now,{backupId:'b3',generation:1,contentHash:H('content3')});assert.throws(()=>x.recovery.recordBackup({manifest:rollback,traceId:'tr3'}),/NOT_MONOTONIC/);}finally{x.close();}});
+
+test('restore requires recorded backup evidence and two distinct controllers',()=>{const now=Date.now(),x=fixture(now);try{const m=manifest(now);assert.throws(()=>x.recovery.authorizeRestore({tenantId:'ta',manifest:m,traceId:'t',requesterId:'u1',approverId:'u2',reason:'drill'}),/EVIDENCE_MISSING/);x.recovery.recordBackup({manifest:m,traceId:'b'});assert.throws(()=>x.recovery.authorizeRestore({tenantId:'ta',manifest:m,traceId:'t',requesterId:'u1',approverId:'u1',reason:'drill'}),/DUAL_CONTROL/);}finally{x.close();}});
+
+test('production recovery is denied without explicit enablement and step-up',()=>{const now=Date.now(),m=manifest(now),x=fixture(now);try{x.recovery.recordBackup({manifest:m,traceId:'b'});assert.throws(()=>x.recovery.authorizeRestore({tenantId:'ta',manifest:m,traceId:'a',requesterId:'u1',approverId:'u2',reason:'incident',targetEnvironment:'production-recovery',stepUpVerified:true}),/NOT_AUTHORIZED/);}finally{x.close();}const y=fixture(now,{allowProductionRestore:true});try{y.recovery.recordBackup({manifest:m,traceId:'b'});assert.throws(()=>y.recovery.authorizeRestore({tenantId:'ta',manifest:m,traceId:'a',requesterId:'u1',approverId:'u2',reason:'incident',targetEnvironment:'production-recovery'}),/NOT_AUTHORIZED/);const ok=y.recovery.authorizeRestore({tenantId:'ta',manifest:m,traceId:'a2',requesterId:'u1',approverId:'u2',reason:'incident',targetEnvironment:'production-recovery',stepUpVerified:true});assert.equal(ok.targetEnvironment,'production-recovery');}finally{y.close();}});
+
+test('restore start is bound to immutable authorization and cannot be replayed',()=>{const now=Date.now(),x=fixture(now);try{const m=manifest(now);x.recovery.recordBackup({manifest:m,traceId:'b'});const auth=x.recovery.authorizeRestore({tenantId:'ta',manifest:m,traceId:'a',requesterId:'u1',approverId:'u2',reason:'drill'});const started=x.recovery.beginRestore({authorization:auth,traceId:'s',actorId:'restore-service'});assert.equal(started.eventType,'RESTORE_STARTED');assert.throws(()=>x.recovery.beginRestore({authorization:auth,traceId:'s2',actorId:'restore-service'}),/ALREADY_STARTED/);assert.throws(()=>x.recovery.beginRestore({authorization:{...auth,backupId:'evil'},traceId:'x',actorId:'restore-service'}),/UNVERIFIED/);}finally{x.close();}});
+
+test('restore verification requires isolated target and complete integrity checks',()=>{const now=Date.now(),x=fixture(now);try{const m=manifest(now);x.recovery.recordBackup({manifest:m,traceId:'b'});const auth=x.recovery.authorizeRestore({tenantId:'ta',manifest:m,traceId:'a',requesterId:'u1',approverId:'u2',reason:'drill'});x.recovery.beginRestore({authorization:auth,traceId:'s',actorId:'restore-service'});const base={tenantId:'ta',restoreId:auth.restoreId,traceId:'v',actorId:'validator',restoredContentHash:H('restored'),expectedManifestHash:m.manifestHash,integrityChecks:{database:true,auditChain:true,objectReferences:true,tenantBoundary:true}};assert.throws(()=>x.recovery.verifyRestore({...base,isolatedTarget:false}),/NOT_ISOLATED/);assert.throws(()=>x.recovery.verifyRestore({...base,integrityChecks:{...base.integrityChecks,tenantBoundary:false}}),/INCOMPLETE/);const ok=x.recovery.verifyRestore(base);assert.equal(ok.eventType,'RESTORE_VERIFIED');assert.equal(x.store.verifyRecoveryEvidenceChain('ta'),true);assert.throws(()=>x.recovery.verifyRestore(base),/ALREADY_VERIFIED/);}finally{x.close();}});
+
+test('recovery evidence chain detects historical tampering',()=>{const now=Date.now(),x=fixture(now);try{x.recovery.recordBackup({manifest:manifest(now),traceId:'b'});assert.equal(x.store.verifyRecoveryEvidenceChain('ta'),true);const row=x.store.db.prepare('SELECT data_json FROM recovery_evidence LIMIT 1').get();const item=JSON.parse(row.data_json);item.outcome='FAILED';x.store.db.exec('DROP TRIGGER recovery_evidence_append_only_update');x.store.db.prepare('UPDATE recovery_evidence SET data_json=?').run(JSON.stringify(item));assert.equal(x.store.verifyRecoveryEvidenceChain('ta'),false);}finally{x.close();}});
