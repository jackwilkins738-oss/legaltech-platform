+++ b/40_PLATFORM_FOUNDATION_BUILD/test/graphDeltaRecoveryV92.test.js
@@ -0,0 +1,31 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {GraphDeltaRecovery} from '../src/graphDeltaRecovery.js';
+import {GraphSubscriptionLifecycle} from '../src/graphSubscriptionLifecycle.js';
+
+const initial='https://graph.microsoft.com/v1.0/users/u/mailFolders/inbox/messages/delta?$select=id,receivedDateTime';
+const next='https://graph.microsoft.com/v1.0/users/u/mailFolders/inbox/messages/delta?$skiptoken=opaque-A';
+const delta='https://graph.microsoft.com/v1.0/users/u/mailFolders/inbox/messages/delta?$deltatoken=opaque-Z';
+function fixture({pages=null,maxPagesPerRun=20,dispatch=null}={}){let now=Date.parse('2026-10-09T06:00:00Z'),seq=0;const secrets=new Map(),fetched=[],changes=[],completed=[];const lifecycle={markRecoveryComplete:(id,{evidenceRef})=>completed.push({id,evidenceRef})};const list=pages??[{value:[{id:'m1'}],'@odata.nextLink':next},{value:[{id:'m2'}],'@odata.deltaLink':delta}];const r=new GraphDeltaRecovery({now:()=>now,maxPagesPerRun,subscriptionLifecycle:lifecycle,fetchPage:async req=>{fetched.push(req.url);return structuredClone(list[seq++]);},dispatchChange:dispatch??(async x=>changes.push(x)),putSecret:async({value})=>{const ref=`secretref://delta/${secrets.size+1}`;secrets.set(ref,value);return ref;},getSecret:async({secretRef})=>secrets.get(secretRef),deleteSecret:async({secretRef})=>secrets.delete(secretRef)});return {r,secrets,fetched,changes,completed,advance:ms=>now+=ms};}
+
+test('V92 follows opaque nextLink exactly and stores terminal deltaLink only through secret reference',async()=>{const f=fixture(),s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'mailbox-a:inbox',traceId:'trace-a',initialUrl:initial});const run=await f.r.run(s.id);assert.equal(run.status,'READY_TO_FINALIZE');assert.deepEqual(f.fetched,[initial,next]);assert.equal(run.pages,2);assert.equal(run.changeCount,2);assert.equal(JSON.stringify(run).includes('$deltatoken'),false);const done=await f.r.finalize(s.id);assert.equal(done.status,'COMPLETED');assert.equal(f.completed.length,1);assert.equal([...f.secrets.values()].includes(delta),true);assert.equal(JSON.stringify(f.r.checkpoint({tenantId:'tenant-a',resourceKey:'mailbox-a:inbox'})).includes(delta),false);});
+
+test('V92 does not reactivate subscription before terminal deltaLink is checkpointed',async()=>{const f=fixture({pages:[{value:[{id:'m1'}],'@odata.nextLink':next}],maxPagesPerRun:1}),s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'mailbox-a:inbox',traceId:'trace',initialUrl:initial}),run=await f.r.run(s.id);assert.equal(run.status,'PAGE_LIMIT');assert.equal(f.completed.length,0);await assert.rejects(()=>f.r.finalize(s.id),/GRAPH_DELTA_STATE_INVALID/);});
+
+test('V92 rejects non-Graph or beta next/delta links rather than following attacker URLs',async()=>{for(const bad of ['https://evil.example/delta?$skiptoken=x','https://graph.microsoft.com/beta/users/delta?$skiptoken=x','http://graph.microsoft.com/v1.0/users/delta?$skiptoken=x']){const f=fixture({pages:[{value:[],'@odata.nextLink':bad}]}),s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'r',traceId:'trace',initialUrl:initial}),run=await f.r.run(s.id);assert.equal(run.status,'FAILED');assert.equal(run.errorCode,'GRAPH_DELTA_LINK_INVALID');assert.equal(f.fetched.length,1);}});
+
+test('V92 requires exactly one nextLink or deltaLink per page',async()=>{for(const page of [{value:[]},{value:[],'@odata.nextLink':next,'@odata.deltaLink':delta}]){const f=fixture({pages:[page]}),s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'r',traceId:'trace',initialUrl:initial}),run=await f.r.run(s.id);assert.equal(run.status,'FAILED');assert.equal(run.errorCode,'GRAPH_DELTA_PAGE_INVALID');}});
+
+test('V92 bounded page run pauses rather than looping indefinitely',async()=>{const f=fixture({pages:[{value:[],'@odata.nextLink':next},{value:[],'@odata.nextLink':next},{value:[],'@odata.deltaLink':delta}],maxPagesPerRun:2}),s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'r',traceId:'trace',initialUrl:initial}),run=await f.r.run(s.id);assert.equal(run.status,'PAGE_LIMIT');assert.equal(run.pages,2);assert.equal(f.fetched.length,2);const resumed=await f.r.run(s.id);assert.equal(resumed.status,'READY_TO_FINALIZE');assert.equal(f.fetched.length,3);});
+
+test('V92 per-page item count is bounded before dispatch',async()=>{const f=fixture({pages:[{value:Array.from({length:501},(_,i)=>({id:String(i)})),'@odata.deltaLink':delta}]}),s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'r',traceId:'trace',initialUrl:initial}),run=await f.r.run(s.id);assert.equal(run.status,'FAILED');assert.equal(run.errorCode,'GRAPH_DELTA_PAGE_INVALID');assert.equal(f.changes.length,0);});
+
+test('V92 dispatch failure never advances checkpoint or reactivates subscription',async()=>{const f=fixture({pages:[{value:[{id:'m1'}],'@odata.deltaLink':delta}],dispatch:async()=>{throw new Error('downstream');}}),s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'r',traceId:'trace',initialUrl:initial}),run=await f.r.run(s.id);assert.equal(run.status,'PAGE_LIMIT');assert.equal(run.errorCode,'GRAPH_DELTA_DISPATCH_FAILED');assert.equal(f.r.checkpoint({tenantId:'tenant-a',resourceKey:'r'}),null);assert.equal(f.completed.length,0);});
+
+test('V92 existing checkpoint is hash-verified before reuse and raw token never appears in events',async()=>{const f=fixture({pages:[{value:[],'@odata.deltaLink':delta}]});const cp=await f.r.seedCheckpoint({tenantId:'tenant-a',resourceKey:'r',deltaLink:next});assert.equal(cp.generation,1);const s=await f.r.start({tenantId:'tenant-a',subscriptionId:'sub-a',resourceKey:'r',traceId:'trace'});await f.r.run(s.id);assert.equal(f.fetched[0],next);const text=JSON.stringify(f.r.events('tenant-a'));assert.equal(text.includes('$skiptoken'),false);assert.equal(text.includes('$deltatoken'),false);});
+
