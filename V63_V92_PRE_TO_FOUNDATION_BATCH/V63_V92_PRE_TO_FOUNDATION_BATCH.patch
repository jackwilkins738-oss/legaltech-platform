diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/017_data_lifecycle.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/017_data_lifecycle.sql
new file mode 100644
index 0000000..6b5fbad
--- /dev/null
+++ b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/017_data_lifecycle.sql
@@ -0,0 +1,136 @@
+BEGIN;
+
+-- V79: generic data-lifecycle policy, legal holds and dual-control disposition intent.
+-- This migration does not create an automatic deletion worker or default retention period.
+CREATE TABLE data_lifecycle_policies (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  policy_key text NOT NULL CHECK (policy_key ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  policy_version integer NOT NULL CHECK (policy_version > 0),
+  resource_class text NOT NULL CHECK (resource_class ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  retention_days integer NOT NULL CHECK (retention_days BETWEEN 1 AND 36500),
+  status text NOT NULL CHECK (status IN ('DRAFT','PUBLISHED','RETIRED')),
+  definition_hash text NOT NULL CHECK (definition_hash ~ '^[a-f0-9]{64}$'),
+  created_by uuid NOT NULL,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  published_at timestamptz,
+  retired_at timestamptz,
+  UNIQUE (tenant_id,id),
+  UNIQUE (tenant_id,policy_key,policy_version),
+  FOREIGN KEY (tenant_id,created_by) REFERENCES actors(tenant_id,id)
+);
+CREATE INDEX idx_data_lifecycle_policy_lookup ON data_lifecycle_policies(tenant_id,policy_key,policy_version);
+
+CREATE TABLE legal_holds (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  scope_kind text NOT NULL CHECK (scope_kind IN ('RESOURCE','MATTER')),
+  resource_class text,
+  resource_ref text,
+  matter_id uuid,
+  reason_code text NOT NULL CHECK (reason_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  status text NOT NULL CHECK (status IN ('ACTIVE','RELEASED')),
+  created_by uuid NOT NULL,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  released_by uuid,
+  released_at timestamptz,
+  release_reason_code text,
+  UNIQUE (tenant_id,id),
+  FOREIGN KEY (tenant_id,created_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,released_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,matter_id) REFERENCES matters(tenant_id,id),
+  CHECK ((scope_kind='MATTER' AND matter_id IS NOT NULL AND resource_class IS NULL AND resource_ref IS NULL) OR (scope_kind='RESOURCE' AND matter_id IS NULL AND resource_class IS NOT NULL AND resource_ref IS NOT NULL)),
+  CHECK (release_reason_code IS NULL OR release_reason_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  CHECK ((status='ACTIVE' AND released_by IS NULL AND released_at IS NULL AND release_reason_code IS NULL) OR (status='RELEASED' AND released_by IS NOT NULL AND released_at IS NOT NULL AND release_reason_code IS NOT NULL))
+);
+CREATE INDEX idx_legal_holds_active_matter ON legal_holds(tenant_id,matter_id) WHERE status='ACTIVE';
+CREATE INDEX idx_legal_holds_active_resource ON legal_holds(tenant_id,resource_class,resource_ref) WHERE status='ACTIVE';
+
+CREATE TABLE disposition_intents (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  policy_key text NOT NULL,
+  policy_version integer NOT NULL,
+  policy_hash text NOT NULL CHECK (policy_hash ~ '^[a-f0-9]{64}$'),
+  resource_class text NOT NULL,
+  resource_ref text NOT NULL,
+  matter_id uuid,
+  resource_created_at timestamptz NOT NULL,
+  eligible_at timestamptz NOT NULL,
+  status text NOT NULL CHECK (status IN ('PENDING_APPROVAL','APPROVED','CANCELLED')),
+  requested_by uuid NOT NULL,
+  requested_at timestamptz NOT NULL DEFAULT now(),
+  approved_by uuid,
+  approved_at timestamptz,
+  cancelled_by uuid,
+  cancelled_at timestamptz,
+  cancel_reason_code text,
+  UNIQUE (tenant_id,id),
+  FOREIGN KEY (tenant_id,policy_key,policy_version) REFERENCES data_lifecycle_policies(tenant_id,policy_key,policy_version),
+  FOREIGN KEY (tenant_id,matter_id) REFERENCES matters(tenant_id,id),
+  FOREIGN KEY (tenant_id,requested_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,approved_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,cancelled_by) REFERENCES actors(tenant_id,id),
+  CHECK (eligible_at >= resource_created_at),
+  CHECK (approved_by IS NULL OR approved_by <> requested_by),
+  CHECK (cancel_reason_code IS NULL OR cancel_reason_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  CHECK ((status='PENDING_APPROVAL' AND approved_by IS NULL AND approved_at IS NULL AND cancelled_by IS NULL AND cancelled_at IS NULL AND cancel_reason_code IS NULL) OR (status='APPROVED' AND approved_by IS NOT NULL AND approved_at IS NOT NULL AND approved_by <> requested_by AND cancelled_by IS NULL AND cancelled_at IS NULL AND cancel_reason_code IS NULL) OR (status='CANCELLED' AND approved_by IS NULL AND approved_at IS NULL AND cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND cancel_reason_code IS NOT NULL))
+);
+CREATE INDEX idx_disposition_intents_queue ON disposition_intents(tenant_id,status,eligible_at,requested_at);
+
+CREATE TABLE data_lifecycle_events (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  object_id text NOT NULL,
+  event_type text NOT NULL CHECK (event_type IN ('POLICY_DRAFT_CREATED','POLICY_PUBLISHED','POLICY_RETIRED','LEGAL_HOLD_PLACED','LEGAL_HOLD_RELEASED','DISPOSITION_PLANNED','DISPOSITION_APPROVED','DISPOSITION_CANCELLED')),
+  actor_id uuid NOT NULL,
+  trace_id text NOT NULL,
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,actor_id) REFERENCES actors(tenant_id,id)
+);
+CREATE INDEX idx_data_lifecycle_events ON data_lifecycle_events(tenant_id,object_id,id);
+
+ALTER TABLE data_lifecycle_policies ENABLE ROW LEVEL SECURITY;
+ALTER TABLE data_lifecycle_policies FORCE ROW LEVEL SECURITY;
+ALTER TABLE legal_holds ENABLE ROW LEVEL SECURITY;
+ALTER TABLE legal_holds FORCE ROW LEVEL SECURITY;
+ALTER TABLE disposition_intents ENABLE ROW LEVEL SECURITY;
+ALTER TABLE disposition_intents FORCE ROW LEVEL SECURITY;
+ALTER TABLE data_lifecycle_events ENABLE ROW LEVEL SECURITY;
+ALTER TABLE data_lifecycle_events FORCE ROW LEVEL SECURITY;
+
+CREATE POLICY tenant_data_lifecycle_policies ON data_lifecycle_policies USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_legal_holds ON legal_holds USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_disposition_intents ON disposition_intents USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_data_lifecycle_events_read ON data_lifecycle_events FOR SELECT USING (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_data_lifecycle_events_insert ON data_lifecycle_events FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id());
+
+CREATE OR REPLACE FUNCTION protect_data_lifecycle_policy_transition() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN
+  IF NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.id IS DISTINCT FROM OLD.id OR NEW.policy_key IS DISTINCT FROM OLD.policy_key OR NEW.policy_version IS DISTINCT FROM OLD.policy_version OR NEW.resource_class IS DISTINCT FROM OLD.resource_class OR NEW.retention_days IS DISTINCT FROM OLD.retention_days OR NEW.definition_hash IS DISTINCT FROM OLD.definition_hash OR NOT ((OLD.status='DRAFT' AND NEW.status='PUBLISHED' AND NEW.published_at IS NOT NULL AND NEW.retired_at IS NULL) OR (OLD.status='PUBLISHED' AND NEW.status='RETIRED' AND NEW.published_at IS NOT NULL AND NEW.retired_at IS NOT NULL)) THEN RAISE EXCEPTION 'data lifecycle policy transition invalid'; END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER data_lifecycle_policy_transition_guard BEFORE UPDATE ON data_lifecycle_policies FOR EACH ROW EXECUTE FUNCTION protect_data_lifecycle_policy_transition();
+
+CREATE OR REPLACE FUNCTION protect_legal_hold_transition() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN
+  IF NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.id IS DISTINCT FROM OLD.id OR NEW.scope_kind IS DISTINCT FROM OLD.scope_kind OR NEW.resource_class IS DISTINCT FROM OLD.resource_class OR NEW.resource_ref IS DISTINCT FROM OLD.resource_ref OR NEW.matter_id IS DISTINCT FROM OLD.matter_id OR NEW.reason_code IS DISTINCT FROM OLD.reason_code OR NOT (OLD.status='ACTIVE' AND NEW.status='RELEASED' AND NEW.released_by IS NOT NULL AND NEW.released_at IS NOT NULL AND NEW.release_reason_code IS NOT NULL) THEN RAISE EXCEPTION 'legal hold transition invalid'; END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER legal_hold_transition_guard BEFORE UPDATE ON legal_holds FOR EACH ROW EXECUTE FUNCTION protect_legal_hold_transition();
+
+CREATE OR REPLACE FUNCTION protect_disposition_intent_transition() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN
+  IF NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.id IS DISTINCT FROM OLD.id OR NEW.policy_key IS DISTINCT FROM OLD.policy_key OR NEW.policy_version IS DISTINCT FROM OLD.policy_version OR NEW.policy_hash IS DISTINCT FROM OLD.policy_hash OR NEW.resource_class IS DISTINCT FROM OLD.resource_class OR NEW.resource_ref IS DISTINCT FROM OLD.resource_ref OR NEW.matter_id IS DISTINCT FROM OLD.matter_id OR NEW.resource_created_at IS DISTINCT FROM OLD.resource_created_at OR NEW.eligible_at IS DISTINCT FROM OLD.eligible_at OR NOT (OLD.status='PENDING_APPROVAL' AND NEW.status IN ('APPROVED','CANCELLED')) THEN RAISE EXCEPTION 'disposition intent transition invalid'; END IF;
+  IF NEW.status='APPROVED' AND (NEW.approved_by IS NULL OR NEW.approved_by=NEW.requested_by OR NEW.approved_at IS NULL OR NEW.cancelled_by IS NOT NULL) THEN RAISE EXCEPTION 'disposition dual control required'; END IF;
+  IF NEW.status='CANCELLED' AND (NEW.cancelled_by IS NULL OR NEW.cancelled_at IS NULL OR NEW.cancel_reason_code IS NULL OR NEW.approved_by IS NOT NULL) THEN RAISE EXCEPTION 'disposition cancellation evidence required'; END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER disposition_intent_transition_guard BEFORE UPDATE ON disposition_intents FOR EACH ROW EXECUTE FUNCTION protect_disposition_intent_transition();
+
+CREATE OR REPLACE FUNCTION deny_data_lifecycle_event_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'data lifecycle events are append-only'; END; $$;
+CREATE TRIGGER data_lifecycle_events_append_only BEFORE UPDATE OR DELETE ON data_lifecycle_events FOR EACH ROW EXECUTE FUNCTION deny_data_lifecycle_event_mutation();
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/018_controlled_export.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/018_controlled_export.sql
new file mode 100644
index 0000000..8642f62
--- /dev/null
+++ b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/018_controlled_export.sql
@@ -0,0 +1,119 @@
+BEGIN;
+
+-- V81: controlled data-export package and single-use actor-bound download grants.
+-- No public links, arbitrary outbound destinations, email delivery or raw package bytes are stored here.
+CREATE TABLE controlled_exports (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  requested_by uuid NOT NULL,
+  format text NOT NULL CHECK (format ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  resource_count integer NOT NULL CHECK (resource_count BETWEEN 1 AND 5000),
+  matter_count integer NOT NULL CHECK (matter_count BETWEEN 0 AND resource_count),
+  manifest_hash text NOT NULL CHECK (manifest_hash ~ '^[a-f0-9]{64}$'),
+  status text NOT NULL CHECK (status IN ('REQUESTED','READY','REVOKED')),
+  package_sha256 text CHECK (package_sha256 ~ '^[a-f0-9]{64}$'),
+  package_bytes bigint CHECK (package_bytes BETWEEN 1 AND 262144000),
+  storage_ref text,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  ready_at timestamptz,
+  revoked_at timestamptz,
+  revoked_by uuid,
+  UNIQUE (tenant_id,id),
+  FOREIGN KEY (tenant_id,requested_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,revoked_by) REFERENCES actors(tenant_id,id),
+  CHECK ((status='REQUESTED' AND package_sha256 IS NULL AND package_bytes IS NULL AND storage_ref IS NULL AND ready_at IS NULL AND revoked_at IS NULL AND revoked_by IS NULL) OR
+         (status='READY' AND package_sha256 IS NOT NULL AND package_bytes IS NOT NULL AND storage_ref IS NOT NULL AND ready_at IS NOT NULL AND revoked_at IS NULL AND revoked_by IS NULL) OR
+         (status='REVOKED' AND revoked_at IS NOT NULL AND revoked_by IS NOT NULL))
+);
+CREATE INDEX idx_controlled_exports_actor ON controlled_exports(tenant_id,requested_by,status,created_at);
+
+CREATE TABLE controlled_export_resources (
+  tenant_id uuid NOT NULL,
+  export_id uuid NOT NULL,
+  resource_class text NOT NULL CHECK (resource_class ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  resource_ref text NOT NULL CHECK (length(resource_ref) BETWEEN 1 AND 256),
+  matter_id uuid,
+  PRIMARY KEY (tenant_id,export_id,resource_class,resource_ref),
+  FOREIGN KEY (tenant_id,export_id) REFERENCES controlled_exports(tenant_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (tenant_id,matter_id) REFERENCES matters(tenant_id,id)
+);
+CREATE INDEX idx_controlled_export_resources_matter ON controlled_export_resources(tenant_id,matter_id,export_id);
+
+CREATE TABLE controlled_export_download_grants (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL,
+  export_id uuid NOT NULL,
+  actor_id uuid NOT NULL,
+  token_hash text NOT NULL CHECK (token_hash ~ '^[a-f0-9]{64}$'),
+  status text NOT NULL CHECK (status IN ('ACTIVE','CONSUMED','REVOKED')),
+  issued_at timestamptz NOT NULL DEFAULT now(),
+  expires_at timestamptz NOT NULL,
+  consumed_at timestamptz,
+  revoked_at timestamptz,
+  UNIQUE (tenant_id,id),
+  UNIQUE (tenant_id,token_hash),
+  FOREIGN KEY (tenant_id,export_id) REFERENCES controlled_exports(tenant_id,id),
+  FOREIGN KEY (tenant_id,actor_id) REFERENCES actors(tenant_id,id),
+  CHECK (expires_at > issued_at AND expires_at <= issued_at + interval '15 minutes'),
+  CHECK ((status='ACTIVE' AND consumed_at IS NULL AND revoked_at IS NULL) OR
+         (status='CONSUMED' AND consumed_at IS NOT NULL AND revoked_at IS NULL) OR
+         (status='REVOKED' AND consumed_at IS NULL AND revoked_at IS NOT NULL))
+);
+CREATE INDEX idx_controlled_export_grants_active ON controlled_export_download_grants(tenant_id,export_id,status,expires_at);
+
+CREATE TABLE controlled_export_events (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  export_id uuid NOT NULL,
+  event_type text NOT NULL CHECK (event_type IN ('EXPORT_REQUESTED','EXPORT_READY','EXPORT_DOWNLOAD_GRANT_ISSUED','EXPORT_DOWNLOADED','EXPORT_REVOKED')),
+  actor_id uuid NOT NULL,
+  trace_id text NOT NULL,
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,export_id) REFERENCES controlled_exports(tenant_id,id),
+  FOREIGN KEY (tenant_id,actor_id) REFERENCES actors(tenant_id,id)
+);
+CREATE INDEX idx_controlled_export_events_export ON controlled_export_events(tenant_id,export_id,id);
+
+ALTER TABLE controlled_exports ENABLE ROW LEVEL SECURITY;
+ALTER TABLE controlled_exports FORCE ROW LEVEL SECURITY;
+ALTER TABLE controlled_export_resources ENABLE ROW LEVEL SECURITY;
+ALTER TABLE controlled_export_resources FORCE ROW LEVEL SECURITY;
+ALTER TABLE controlled_export_download_grants ENABLE ROW LEVEL SECURITY;
+ALTER TABLE controlled_export_download_grants FORCE ROW LEVEL SECURITY;
+ALTER TABLE controlled_export_events ENABLE ROW LEVEL SECURITY;
+ALTER TABLE controlled_export_events FORCE ROW LEVEL SECURITY;
+
+CREATE POLICY tenant_controlled_exports ON controlled_exports USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_controlled_export_resources ON controlled_export_resources USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_controlled_export_grants ON controlled_export_download_grants USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_controlled_export_events_read ON controlled_export_events FOR SELECT USING (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_controlled_export_events_insert ON controlled_export_events FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id());
+
+CREATE OR REPLACE FUNCTION protect_controlled_export_transition() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN
+  IF NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.id IS DISTINCT FROM OLD.id OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.format IS DISTINCT FROM OLD.format OR NEW.resource_count IS DISTINCT FROM OLD.resource_count OR NEW.matter_count IS DISTINCT FROM OLD.matter_count OR NEW.manifest_hash IS DISTINCT FROM OLD.manifest_hash OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN RAISE EXCEPTION 'controlled export identity immutable'; END IF;
+  IF NOT ((OLD.status='REQUESTED' AND NEW.status IN ('READY','REVOKED')) OR (OLD.status='READY' AND NEW.status='REVOKED')) THEN RAISE EXCEPTION 'controlled export transition invalid'; END IF;
+  IF NEW.status='READY' AND (NEW.package_sha256 IS NULL OR NEW.package_bytes IS NULL OR NEW.storage_ref IS NULL OR NEW.ready_at IS NULL) THEN RAISE EXCEPTION 'controlled export ready evidence required'; END IF;
+  IF NEW.status='REVOKED' AND (NEW.revoked_at IS NULL OR NEW.revoked_by IS NULL) THEN RAISE EXCEPTION 'controlled export revocation evidence required'; END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER controlled_export_transition_guard BEFORE UPDATE ON controlled_exports FOR EACH ROW EXECUTE FUNCTION protect_controlled_export_transition();
+
+CREATE OR REPLACE FUNCTION deny_controlled_export_resource_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'controlled export resources are immutable'; END; $$;
+CREATE TRIGGER controlled_export_resources_immutable BEFORE UPDATE OR DELETE ON controlled_export_resources FOR EACH ROW EXECUTE FUNCTION deny_controlled_export_resource_mutation();
+
+CREATE OR REPLACE FUNCTION protect_controlled_export_grant_transition() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN
+  IF NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.id IS DISTINCT FROM OLD.id OR NEW.export_id IS DISTINCT FROM OLD.export_id OR NEW.actor_id IS DISTINCT FROM OLD.actor_id OR NEW.token_hash IS DISTINCT FROM OLD.token_hash OR NEW.issued_at IS DISTINCT FROM OLD.issued_at OR NEW.expires_at IS DISTINCT FROM OLD.expires_at THEN RAISE EXCEPTION 'export grant identity immutable'; END IF;
+  IF NOT (OLD.status='ACTIVE' AND NEW.status IN ('CONSUMED','REVOKED')) THEN RAISE EXCEPTION 'export grant transition invalid'; END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER controlled_export_grant_transition_guard BEFORE UPDATE ON controlled_export_download_grants FOR EACH ROW EXECUTE FUNCTION protect_controlled_export_grant_transition();
+
+CREATE OR REPLACE FUNCTION deny_controlled_export_event_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'controlled export events are append-only'; END; $$;
+CREATE TRIGGER controlled_export_events_append_only BEFORE UPDATE OR DELETE ON controlled_export_events FOR EACH ROW EXECUTE FUNCTION deny_controlled_export_event_mutation();
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/019_security_interlocks.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/019_security_interlocks.sql
new file mode 100644
index 0000000..0bd0d1e
--- /dev/null
+++ b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/019_security_interlocks.sql
@@ -0,0 +1,66 @@
+BEGIN;
+
+-- V82: tenant-scoped incident/security interlocks. Activation is immediate;
+-- release requires a distinct actor and append-only evidence.
+CREATE TABLE security_interlocks (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  control text NOT NULL CHECK (control IN ('ALL_EGRESS','PROCLAIM_WRITE','EXTERNAL_NOTIFICATION','EXPORT','CONNECTOR_USE','NEW_SESSION')),
+  status text NOT NULL CHECK (status IN ('ACTIVE','RELEASED')),
+  incident_id text NOT NULL CHECK (incident_id ~ '^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$'),
+  reason_code text NOT NULL CHECK (reason_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  activated_by uuid NOT NULL,
+  activated_at timestamptz NOT NULL DEFAULT now(),
+  released_by uuid,
+  released_at timestamptz,
+  resolution_code text,
+  UNIQUE (tenant_id,id),
+  FOREIGN KEY (tenant_id,activated_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,released_by) REFERENCES actors(tenant_id,id),
+  CHECK (released_by IS NULL OR released_by <> activated_by),
+  CHECK (resolution_code IS NULL OR resolution_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  CHECK ((status='ACTIVE' AND released_by IS NULL AND released_at IS NULL AND resolution_code IS NULL) OR
+         (status='RELEASED' AND released_by IS NOT NULL AND released_at IS NOT NULL AND resolution_code IS NOT NULL AND released_by <> activated_by))
+);
+CREATE UNIQUE INDEX uq_security_interlock_active ON security_interlocks(tenant_id,control) WHERE status='ACTIVE';
+CREATE INDEX idx_security_interlock_incident ON security_interlocks(tenant_id,incident_id,status);
+
+CREATE TABLE security_interlock_events (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  interlock_id uuid NOT NULL,
+  event_type text NOT NULL CHECK (event_type IN ('INTERLOCK_ACTIVATED','INTERLOCK_RELEASED')),
+  actor_id uuid NOT NULL,
+  trace_id text NOT NULL,
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,interlock_id) REFERENCES security_interlocks(tenant_id,id),
+  FOREIGN KEY (tenant_id,actor_id) REFERENCES actors(tenant_id,id)
+);
+CREATE INDEX idx_security_interlock_events ON security_interlock_events(tenant_id,interlock_id,id);
+
+ALTER TABLE security_interlocks ENABLE ROW LEVEL SECURITY;
+ALTER TABLE security_interlocks FORCE ROW LEVEL SECURITY;
+ALTER TABLE security_interlock_events ENABLE ROW LEVEL SECURITY;
+ALTER TABLE security_interlock_events FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_security_interlocks ON security_interlocks USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_security_interlock_events_read ON security_interlock_events FOR SELECT USING (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_security_interlock_events_insert ON security_interlock_events FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id());
+
+CREATE OR REPLACE FUNCTION protect_security_interlock_transition() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN
+  IF NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.id IS DISTINCT FROM OLD.id OR NEW.control IS DISTINCT FROM OLD.control OR NEW.incident_id IS DISTINCT FROM OLD.incident_id OR NEW.reason_code IS DISTINCT FROM OLD.reason_code OR NEW.activated_by IS DISTINCT FROM OLD.activated_by OR NEW.activated_at IS DISTINCT FROM OLD.activated_at THEN RAISE EXCEPTION 'security interlock identity immutable'; END IF;
+  IF NOT (OLD.status='ACTIVE' AND NEW.status='RELEASED' AND NEW.released_by IS NOT NULL AND NEW.released_by<>OLD.activated_by AND NEW.released_at IS NOT NULL AND NEW.resolution_code IS NOT NULL) THEN RAISE EXCEPTION 'security interlock release invalid'; END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER security_interlock_transition_guard BEFORE UPDATE ON security_interlocks FOR EACH ROW EXECUTE FUNCTION protect_security_interlock_transition();
+
+CREATE OR REPLACE FUNCTION deny_security_interlock_delete() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'security interlocks are evidential'; END; $$;
+CREATE TRIGGER security_interlock_no_delete BEFORE DELETE ON security_interlocks FOR EACH ROW EXECUTE FUNCTION deny_security_interlock_delete();
+
+CREATE OR REPLACE FUNCTION deny_security_interlock_event_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'security interlock events are append-only'; END; $$;
+CREATE TRIGGER security_interlock_events_append_only BEFORE UPDATE OR DELETE ON security_interlock_events FOR EACH ROW EXECUTE FUNCTION deny_security_interlock_event_mutation();
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/020_production_change_control.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/020_production_change_control.sql
new file mode 100644
index 0000000..79a3d75
--- /dev/null
+++ b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/020_production_change_control.sql
@@ -0,0 +1,97 @@
+BEGIN;
+
+-- V83: normal production behavior changes are hash-bound, expiring and dual-control.
+-- Emergency security interlocks remain a separate immediate containment path.
+CREATE TABLE production_change_requests (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  change_type text NOT NULL CHECK (change_type IN ('WORKFLOW_PUBLISH','RESPONSE_POLICY_PUBLISH','FEATURE_FLAG_CHANGE','RETENTION_POLICY_PUBLISH')),
+  target_ref text NOT NULL CHECK (target_ref ~ '^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,255}$'),
+  target_hash char(64) NOT NULL CHECK (target_hash ~ '^[a-f0-9]{64}$'),
+  status text NOT NULL CHECK (status IN ('PENDING_APPROVAL','APPROVED','REJECTED','CANCELLED','CONSUMED')),
+  reason_code text NOT NULL CHECK (reason_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  idempotency_key text NOT NULL CHECK (idempotency_key ~ '^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,255}$'),
+  requested_by uuid NOT NULL,
+  requested_at timestamptz NOT NULL DEFAULT now(),
+  expires_at timestamptz NOT NULL,
+  approved_by uuid,
+  approved_at timestamptz,
+  rejected_by uuid,
+  rejected_at timestamptz,
+  rejection_code text,
+  cancelled_by uuid,
+  cancelled_at timestamptz,
+  cancel_code text,
+  consumed_by uuid,
+  consumed_at timestamptz,
+  UNIQUE (tenant_id,id),
+  UNIQUE (tenant_id,idempotency_key),
+  FOREIGN KEY (tenant_id,requested_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,approved_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,rejected_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,cancelled_by) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,consumed_by) REFERENCES actors(tenant_id,id),
+  CHECK (expires_at > requested_at + interval '1 minute' AND expires_at <= requested_at + interval '7 days'),
+  CHECK (approved_by IS NULL OR approved_by <> requested_by),
+  CHECK (rejected_by IS NULL OR rejected_by <> requested_by),
+  CHECK (rejection_code IS NULL OR rejection_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  CHECK (cancel_code IS NULL OR cancel_code ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,99}$'),
+  CHECK (
+    (status='PENDING_APPROVAL' AND approved_by IS NULL AND rejected_by IS NULL AND cancelled_by IS NULL AND consumed_by IS NULL) OR
+    (status='APPROVED' AND approved_by IS NOT NULL AND approved_at IS NOT NULL AND approved_by<>requested_by AND rejected_by IS NULL AND cancelled_by IS NULL AND consumed_by IS NULL) OR
+    (status='REJECTED' AND rejected_by IS NOT NULL AND rejected_at IS NOT NULL AND rejection_code IS NOT NULL AND approved_by IS NULL AND cancelled_by IS NULL AND consumed_by IS NULL) OR
+    (status='CANCELLED' AND cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND cancel_code IS NOT NULL AND consumed_by IS NULL) OR
+    (status='CONSUMED' AND approved_by IS NOT NULL AND approved_by<>requested_by AND consumed_by IS NOT NULL AND consumed_at IS NOT NULL)
+  )
+);
+CREATE INDEX idx_production_change_pending ON production_change_requests(tenant_id,status,expires_at,requested_at);
+CREATE INDEX idx_production_change_target ON production_change_requests(tenant_id,change_type,target_ref,status);
+
+CREATE TABLE production_change_events (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  change_id uuid NOT NULL,
+  event_type text NOT NULL CHECK (event_type IN ('CHANGE_REQUESTED','CHANGE_APPROVED','CHANGE_REJECTED','CHANGE_CANCELLED','CHANGE_EXECUTION_FAILED','CHANGE_CONSUMED')),
+  actor_id uuid NOT NULL,
+  trace_id text NOT NULL,
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,change_id) REFERENCES production_change_requests(tenant_id,id),
+  FOREIGN KEY (tenant_id,actor_id) REFERENCES actors(tenant_id,id)
+);
+CREATE INDEX idx_production_change_events ON production_change_events(tenant_id,change_id,id);
+
+ALTER TABLE production_change_requests ENABLE ROW LEVEL SECURITY;
+ALTER TABLE production_change_requests FORCE ROW LEVEL SECURITY;
+ALTER TABLE production_change_events ENABLE ROW LEVEL SECURITY;
+ALTER TABLE production_change_events FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_production_change_requests ON production_change_requests USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_production_change_events_read ON production_change_events FOR SELECT USING (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_production_change_events_insert ON production_change_events FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id());
+
+CREATE OR REPLACE FUNCTION protect_production_change_transition() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN
+  IF NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.id IS DISTINCT FROM OLD.id OR NEW.change_type IS DISTINCT FROM OLD.change_type OR NEW.target_ref IS DISTINCT FROM OLD.target_ref OR NEW.target_hash IS DISTINCT FROM OLD.target_hash OR NEW.reason_code IS DISTINCT FROM OLD.reason_code OR NEW.idempotency_key IS DISTINCT FROM OLD.idempotency_key OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.requested_at IS DISTINCT FROM OLD.requested_at OR NEW.expires_at IS DISTINCT FROM OLD.expires_at THEN RAISE EXCEPTION 'production change target identity immutable'; END IF;
+  IF OLD.status='PENDING_APPROVAL' AND NEW.status='APPROVED' THEN
+    IF NEW.approved_by IS NULL OR NEW.approved_by=OLD.requested_by OR NEW.approved_at IS NULL OR now()>=OLD.expires_at THEN RAISE EXCEPTION 'production change approval invalid'; END IF;
+  ELSIF OLD.status='PENDING_APPROVAL' AND NEW.status='REJECTED' THEN
+    IF NEW.rejected_by IS NULL OR NEW.rejected_by=OLD.requested_by OR NEW.rejected_at IS NULL OR NEW.rejection_code IS NULL THEN RAISE EXCEPTION 'production change rejection invalid'; END IF;
+  ELSIF OLD.status IN ('PENDING_APPROVAL','APPROVED') AND NEW.status='CANCELLED' THEN
+    IF NEW.cancelled_by IS NULL OR NEW.cancelled_at IS NULL OR NEW.cancel_code IS NULL THEN RAISE EXCEPTION 'production change cancellation invalid'; END IF;
+  ELSIF OLD.status='APPROVED' AND NEW.status='CONSUMED' THEN
+    IF NEW.consumed_by IS NULL OR NEW.consumed_at IS NULL OR now()>=OLD.expires_at OR OLD.approved_by=OLD.requested_by THEN RAISE EXCEPTION 'production change consumption invalid'; END IF;
+  ELSE RAISE EXCEPTION 'production change transition invalid';
+  END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER production_change_transition_guard BEFORE UPDATE ON production_change_requests FOR EACH ROW EXECUTE FUNCTION protect_production_change_transition();
+
+CREATE OR REPLACE FUNCTION deny_production_change_delete() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'production change requests are evidential'; END; $$;
+CREATE TRIGGER production_change_no_delete BEFORE DELETE ON production_change_requests FOR EACH ROW EXECUTE FUNCTION deny_production_change_delete();
+
+CREATE OR REPLACE FUNCTION deny_production_change_event_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'production change events are append-only'; END; $$;
+CREATE TRIGGER production_change_events_append_only BEFORE UPDATE OR DELETE ON production_change_events FOR EACH ROW EXECUTE FUNCTION deny_production_change_event_mutation();
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/021_worker_execution_identity.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/021_worker_execution_identity.sql
new file mode 100644
index 0000000..6bcdf5f
--- /dev/null
+++ b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/021_worker_execution_identity.sql
@@ -0,0 +1,52 @@
+BEGIN;
+
+-- V84: background execution must be authorized by a short-lived, exact-bound workload grant.
+-- Raw execution tokens are never stored; only a SHA-256 grant fingerprint is durable.
+CREATE TABLE worker_execution_grant_consumptions (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  grant_fingerprint char(64) NOT NULL CHECK (grant_fingerprint ~ '^[a-f0-9]{64}$'),
+  worker_type text NOT NULL CHECK (worker_type ~ '^[A-Z0-9][A-Z0-9_.:/-]{0,127}$'),
+  object_type text NOT NULL CHECK (object_type IN ('JOB','NOTIFICATION')),
+  object_ref text NOT NULL CHECK (object_ref ~ '^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$'),
+  service_ref text NOT NULL CHECK (service_ref ~ '^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$'),
+  trace_id text NOT NULL CHECK (length(trace_id) BETWEEN 1 AND 256),
+  expires_at timestamptz NOT NULL,
+  consumed_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (tenant_id,grant_fingerprint),
+  UNIQUE (tenant_id,id),
+  CHECK (expires_at > consumed_at - interval '30 seconds')
+);
+CREATE INDEX idx_worker_execution_object ON worker_execution_grant_consumptions(tenant_id,worker_type,object_type,object_ref,consumed_at DESC);
+CREATE INDEX idx_worker_execution_service ON worker_execution_grant_consumptions(tenant_id,service_ref,consumed_at DESC);
+
+CREATE TABLE worker_execution_events (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  consumption_id uuid NOT NULL,
+  event_type text NOT NULL CHECK (event_type IN ('AUTHORIZED','CLAIMED','COMPLETED','FAILED','SUPERSEDED')),
+  trace_id text NOT NULL CHECK (length(trace_id) BETWEEN 1 AND 256),
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,consumption_id) REFERENCES worker_execution_grant_consumptions(tenant_id,id)
+);
+CREATE INDEX idx_worker_execution_events ON worker_execution_events(tenant_id,consumption_id,id);
+
+ALTER TABLE worker_execution_grant_consumptions ENABLE ROW LEVEL SECURITY;
+ALTER TABLE worker_execution_grant_consumptions FORCE ROW LEVEL SECURITY;
+ALTER TABLE worker_execution_events ENABLE ROW LEVEL SECURITY;
+ALTER TABLE worker_execution_events FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_worker_execution_consumption_read ON worker_execution_grant_consumptions FOR SELECT USING (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_worker_execution_consumption_insert ON worker_execution_grant_consumptions FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_worker_execution_event_read ON worker_execution_events FOR SELECT USING (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_worker_execution_event_insert ON worker_execution_events FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id());
+
+CREATE OR REPLACE FUNCTION deny_worker_execution_consumption_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'worker execution consumption is immutable'; END; $$;
+CREATE TRIGGER worker_execution_consumption_immutable BEFORE UPDATE OR DELETE ON worker_execution_grant_consumptions FOR EACH ROW EXECUTE FUNCTION deny_worker_execution_consumption_mutation();
+
+CREATE OR REPLACE FUNCTION deny_worker_execution_event_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'worker execution events are append-only'; END; $$;
+CREATE TRIGGER worker_execution_events_append_only BEFORE UPDATE OR DELETE ON worker_execution_events FOR EACH ROW EXECUTE FUNCTION deny_worker_execution_event_mutation();
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/022_audit_checkpoint_anchor.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/022_audit_checkpoint_anchor.sql
