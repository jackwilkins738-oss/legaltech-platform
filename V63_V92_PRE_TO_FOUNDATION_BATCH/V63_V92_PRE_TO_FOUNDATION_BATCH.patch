+import test from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import {ControlledExportRegistry,EXPORT_LIMITS} from '../src/exportSafety.js';
+
+function fx(){let now=Date.parse('2026-10-09T12:00:00.000Z');const allowed=new Set(['tenant-a:matter-1:doc-1','tenant-a:matter-2:doc-2']);const registry=new ControlledExportRegistry({now:()=>now,authorizeResource:({tenantId,resource})=>allowed.has(`${tenantId}:${resource.matterId}:${resource.resourceRef}`),validateStorageRef:({tenantId,storageRef,packageSha256})=>storageRef===`managed:${tenantId}:${packageSha256}`});return {registry,get now(){return now},set now(v){now=v}};}
+const set=[{resourceClass:'DOCUMENT',resourceRef:'doc-1',matterId:'matter-1'}];
+function request(x,over={}){return x.registry.requestExport({tenantId:'tenant-a',actorId:'user-a',traceId:'trace-a',resourceSet:set,format:'ZIP',idempotencyKey:'idem-export-a',...over});}
+function ready(x,row,over={}){const packageSha256='a'.repeat(64);return x.registry.markReady({tenantId:'tenant-a',exportId:row.id,actorId:'service-export',traceId:'trace-ready',manifestHash:row.manifestHash,packageSha256,packageBytes:1024,storageRef:`managed:tenant-a:${packageSha256}`,...over});}
+
+test('V81 export request authorizes every resource before creating state',()=>{const x=fx();const row=request(x);assert.equal(row.status,'REQUESTED');assert.equal(row.resourceCount,1);assert.equal(row.matterCount,1);assert.throws(()=>request(x,{idempotencyKey:'blocked',resourceSet:[{resourceClass:'DOCUMENT',resourceRef:'nope',matterId:'matter-1'}]}),/EXPORT_RESOURCE_FORBIDDEN/);});
+test('V81 cross-tenant authorization does not inherit from an allowed tenant',()=>{const x=fx();assert.throws(()=>request(x,{tenantId:'tenant-b',idempotencyKey:'tenant-b-idem'}),/EXPORT_RESOURCE_FORBIDDEN/);assert.equal(x.registry.listEvents('tenant-b').length,0);});
+test('V81 request shape rejects browser supplied destinations and arbitrary egress fields',()=>{const x=fx();assert.throws(()=>request(x,{destinationUrl:'https://example.invalid'}),/EXPORT_REQUEST_SHAPE_INVALID/);assert.throws(()=>request(x,{email:'outside@example.invalid'}),/EXPORT_REQUEST_SHAPE_INVALID/);});
+test('V81 resource set is bounded and duplicate references fail closed',()=>{const x=fx();assert.equal(EXPORT_LIMITS.maxResources,5000);assert.throws(()=>request(x,{resourceSet:[...set,...set]}),/EXPORT_RESOURCE_DUPLICATE/);assert.throws(()=>request(x,{resourceSet:[]}),/EXPORT_RESOURCE_SET_INVALID/);});
+test('V81 idempotent replay cannot change the export manifest',()=>{const x=fx();const first=request(x),replay=request(x);assert.equal(replay.id,first.id);assert.equal(replay.replayed,true);assert.throws(()=>request(x,{resourceSet:[{resourceClass:'DOCUMENT',resourceRef:'doc-2',matterId:'matter-2'}]}),/EXPORT_IDEMPOTENCY_CONFLICT/);});
+test('V81 ready transition requires exact manifest digest and managed storage evidence',()=>{const x=fx(),row=request(x);assert.throws(()=>ready(x,row,{manifestHash:'b'.repeat(64)}),/EXPORT_MANIFEST_MISMATCH/);assert.throws(()=>ready(x,row,{storageRef:'public:https://example.invalid'}),/EXPORT_STORAGE_EVIDENCE_INVALID/);const done=ready(x,row);assert.equal(done.status,'READY');assert.equal(done.packageSha256,'a'.repeat(64));});
+test('V81 package size is bounded before an export becomes downloadable',()=>{const x=fx(),row=request(x);assert.throws(()=>ready(x,row,{packageBytes:EXPORT_LIMITS.maxPackageBytes+1}),/EXPORT_PACKAGE_SIZE_INVALID/);assert.equal(x.registry.getExport('tenant-a',row.id).status,'REQUESTED');});
+test('V81 download grant is requester-bound, short-lived and token is not persisted in events',()=>{const x=fx(),row=request(x);ready(x,row);assert.throws(()=>x.registry.issueDownloadGrant({tenantId:'tenant-a',exportId:row.id,actorId:'other-user',traceId:'trace',ttlMs:60_000}),/EXPORT_GRANT_ACTOR_FORBIDDEN/);const grant=x.registry.issueDownloadGrant({tenantId:'tenant-a',exportId:row.id,actorId:'user-a',traceId:'trace',ttlMs:60_000});assert.match(grant.token,/^[A-Za-z0-9_-]+$/);const events=JSON.stringify(x.registry.listEvents('tenant-a'));assert.equal(events.includes(grant.token),false);assert.equal(events.includes(crypto.createHash('sha256').update(grant.token).digest('hex')),false);});
+test('V81 download token is single-use and actor/tenant bound',()=>{const x=fx(),row=request(x);ready(x,row);const grant=x.registry.issueDownloadGrant({tenantId:'tenant-a',exportId:row.id,actorId:'user-a',traceId:'trace',ttlMs:60_000});assert.throws(()=>x.registry.consumeDownloadGrant({tenantId:'tenant-a',grantId:grant.grantId,actorId:'user-b',traceId:'x',token:grant.token}),/EXPORT_GRANT_INVALID/);const out=x.registry.consumeDownloadGrant({tenantId:'tenant-a',grantId:grant.grantId,actorId:'user-a',traceId:'x',token:grant.token});assert.equal(out.packageSha256,'a'.repeat(64));assert.throws(()=>x.registry.consumeDownloadGrant({tenantId:'tenant-a',grantId:grant.grantId,actorId:'user-a',traceId:'x',token:grant.token}),/EXPORT_GRANT_INVALID/);});
+test('V81 expired grants fail closed without revealing storage reference',()=>{const x=fx(),row=request(x);ready(x,row);const grant=x.registry.issueDownloadGrant({tenantId:'tenant-a',exportId:row.id,actorId:'user-a',traceId:'trace',ttlMs:1000});x.now+=1001;assert.throws(()=>x.registry.consumeDownloadGrant({tenantId:'tenant-a',grantId:grant.grantId,actorId:'user-a',traceId:'x',token:grant.token}),/EXPORT_GRANT_INVALID/);});
+test('V81 revocation invalidates active grants and prevents further download',()=>{const x=fx(),row=request(x);ready(x,row);const grant=x.registry.issueDownloadGrant({tenantId:'tenant-a',exportId:row.id,actorId:'user-a',traceId:'trace',ttlMs:60_000});const revoked=x.registry.revokeExport({tenantId:'tenant-a',exportId:row.id,actorId:'security-a',traceId:'rev'});assert.equal(revoked.status,'REVOKED');assert.throws(()=>x.registry.consumeDownloadGrant({tenantId:'tenant-a',grantId:grant.grantId,actorId:'user-a',traceId:'x',token:grant.token}),/EXPORT_GRANT_INVALID/);});
+test('V81 raw package bytes and public URLs are deliberately outside registry authority',()=>{const x=fx();assert.equal(typeof x.registry.putBytes,'undefined');assert.equal(typeof x.registry.createPublicLink,'undefined');assert.equal(typeof x.registry.emailExport,'undefined');});
+
+test('V81 export audit actions are treated as privileged security events',async()=>{
+  const {PlatformStore}=await import('../src/store.js');
+  const {SecurityMonitor}=await import('../src/securityMonitoring.js');
+  const store=new PlatformStore(':memory:'),alerts=[];const monitor=new SecurityMonitor({store,alertSink:{emit:a=>alerts.push(a)}});store.attachSecurityMonitor(monitor);
+  try{store.audit({tenantId:'tenant-a',traceId:'trace-export',actorId:'user-a',action:'EXPORT_PACKAGE_DOWNLOADED',objectId:'exp-1',outcome:'SUCCESS'});assert.equal(alerts.some(a=>a.type==='PRIVILEGED_ACTION'&&a.action==='EXPORT_PACKAGE_DOWNLOADED'),true);}finally{store.close();}
+});
diff --git a/40_PLATFORM_FOUNDATION_BUILD/test/graphDeltaRecoveryV92.test.js b/40_PLATFORM_FOUNDATION_BUILD/test/graphDeltaRecoveryV92.test.js
