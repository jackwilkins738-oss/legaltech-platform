+import {DataLifecycleRegistry} from '../src/dataLifecycle.js';
+
+function controlFixture(){let now=Date.parse('2026-10-09T12:00:00.000Z');const allowed=new Set(['requester','approver','publisher','admin-a','admin-b']);const changeControl=new ChangeControlRegistry({now:()=>now,authorizeChange:({actorId})=>allowed.has(actorId)});return {changeControl,get now(){return now},set now(v){now=v}};}
+function proposal(x,{changeType='WORKFLOW_PUBLISH',targetRef='wf@1',targetHash='a'.repeat(64),requestedBy='requester',idem='idem-1'}={}){return x.changeControl.propose({tenantId:'ta',changeType,targetRef,targetHash,requestedBy,traceId:'trace-request',reasonCode:'PLANNED_CHANGE',idempotencyKey:idem,expiresAt:new Date(x.now+60*60*1000).toISOString()});}
+
+test('V83 change request is authorization-gated, exact-bound and idempotent',()=>{const x=controlFixture();const first=proposal(x),again=proposal(x);assert.equal(again.id,first.id);assert.equal(again.replayed,true);assert.throws(()=>proposal(x,{targetHash:'b'.repeat(64)}),/IDEMPOTENCY_CONFLICT/);assert.throws(()=>proposal(x,{requestedBy:'ordinary'}),/CHANGE_CONTROL_FORBIDDEN/);});
+
+test('V83 approval requires a different authorized actor',()=>{const x=controlFixture(),row=proposal(x);assert.throws(()=>x.changeControl.approve({tenantId:'ta',changeId:row.id,actorId:'requester',traceId:'same'}),/DUAL_CONTROL/);const approved=x.changeControl.approve({tenantId:'ta',changeId:row.id,actorId:'approver',traceId:'approve'});assert.equal(approved.status,'APPROVED');assert.equal(approved.approvedBy,'approver');});
+
+test('V83 stale approvals and changed targets fail closed',()=>{const x=controlFixture(),row=proposal(x);x.changeControl.approve({tenantId:'ta',changeId:row.id,actorId:'approver',traceId:'approve'});assert.throws(()=>x.changeControl.executeApproved({tenantId:'ta',changeId:row.id,changeType:'WORKFLOW_PUBLISH',targetRef:'wf@2',targetHash:'a'.repeat(64),actorId:'publisher',traceId:'exec'},()=>true),/TARGET_MISMATCH/);x.now+=2*60*60*1000;assert.throws(()=>x.changeControl.executeApproved({tenantId:'ta',changeId:row.id,changeType:'WORKFLOW_PUBLISH',targetRef:'wf@1',targetHash:'a'.repeat(64),actorId:'publisher',traceId:'exec'},()=>true),/EXPIRED/);});
+
+test('V83 approval is single-use and action failure does not burn approval evidence',()=>{const x=controlFixture(),row=proposal(x);x.changeControl.approve({tenantId:'ta',changeId:row.id,actorId:'approver',traceId:'approve'});const args={tenantId:'ta',changeId:row.id,changeType:'WORKFLOW_PUBLISH',targetRef:'wf@1',targetHash:'a'.repeat(64),actorId:'publisher',traceId:'exec'};assert.throws(()=>x.changeControl.executeApproved(args,()=>{throw new Error('downstream');}),/downstream/);assert.equal(x.changeControl.get('ta',row.id).status,'APPROVED');assert.equal(x.changeControl.executeApproved(args,()=>42),42);assert.equal(x.changeControl.get('ta',row.id).status,'CONSUMED');assert.throws(()=>x.changeControl.executeApproved(args,()=>99),/CHANGE_REQUEST_UNAVAILABLE/);});
+
+test('V83 event history is append-only at the public API surface',()=>{const x=controlFixture(),row=proposal(x);x.changeControl.approve({tenantId:'ta',changeId:row.id,actorId:'approver',traceId:'approve'});x.changeControl.executeApproved({tenantId:'ta',changeId:row.id,changeType:'WORKFLOW_PUBLISH',targetRef:'wf@1',targetHash:'a'.repeat(64),actorId:'publisher',traceId:'exec'},()=>true);assert.deepEqual(x.changeControl.listEvents('ta').map(e=>e.eventType),['CHANGE_REQUESTED','CHANGE_APPROVED','CHANGE_CONSUMED']);assert.equal(typeof x.changeControl.deleteEvent,'undefined');});
+
+function platformFixture(){const c=controlFixture(),store=new PlatformStore(':memory:',{matters:[{id:'m1',tenantId:'ta',externalId:'A',externalRefs:[]}]});const work=new WorkOrchestrator({store,now:()=>c.now});const flags=new FeatureFlags({store,changeControl:c.changeControl});const notifications=new NotificationIntents({store,now:()=>c.now});const workflow=new WorkflowRuntime({store,workOrchestrator:work,notificationIntents:notifications,featureFlags:flags,changeControl:c.changeControl,now:()=>c.now});const escalation=new WorkEscalationEngine({store,workOrchestrator:work,notificationIntents:notifications,changeControl:c.changeControl,now:()=>c.now});return {...c,store,work,flags,notifications,workflow,escalation,close:()=>store.close()};}
+const wfDef={entryStepId:'done',steps:[{id:'done',kind:'COMPLETE'}]};
+function approvedChange(x,{changeType,targetRef,targetHash,idem}){const row=proposal(x,{changeType,targetRef,targetHash,idem});x.changeControl.approve({tenantId:'ta',changeId:row.id,actorId:'approver',traceId:'approve'});return row.id;}
+
+test('V83 workflow publish requires exact approved definition hash when change control is enabled',()=>{const x=platformFixture();try{const draft=x.workflow.createDraft({tenantId:'ta',workflowKey:'wf',name:'Workflow',definition:wfDef,actorId:'requester',traceId:'draft'});assert.throws(()=>x.workflow.publish({tenantId:'ta',workflowKey:'wf',version:draft.version,actorId:'publisher',traceId:'publish'}),/APPROVAL_REQUIRED/);const changeId=approvedChange(x,{changeType:'WORKFLOW_PUBLISH',targetRef:`wf@${draft.version}`,targetHash:draft.definitionHash,idem:'workflow'});const published=x.workflow.publish({tenantId:'ta',workflowKey:'wf',version:draft.version,actorId:'publisher',traceId:'publish',changeId});assert.equal(published.status,'PUBLISHED');assert.equal(x.changeControl.get('ta',changeId).status,'CONSUMED');}finally{x.close();}});
+
+test('V83 response-policy publish consumes exact approved policy hash',()=>{const x=platformFixture();try{const draft=x.escalation.createDraft({tenantId:'ta',policyKey:'RESP',name:'Response',definition:{clock:'CREATED_AT',thresholdMs:1000,action:'NOTIFY_OWNER',selector:{types:['DECISION']},channel:'IN_APP',severity:'NORMAL'},actorId:'requester',traceId:'draft'});const changeId=approvedChange(x,{changeType:'RESPONSE_POLICY_PUBLISH',targetRef:`RESP@${draft.version}`,targetHash:draft.definitionHash,idem:'response'});assert.equal(x.escalation.publish({tenantId:'ta',policyKey:'RESP',version:draft.version,actorId:'publisher',traceId:'publish',changeId}).status,'PUBLISHED');}finally{x.close();}});
+
+test('V83 feature-flag change is exact-bound to desired value and expected version',()=>{const x=platformFixture();try{const targetHash=hashChangeTarget({key:'pilot',enabled:true,rolloutPercent:25,expectedVersion:null});const changeId=approvedChange(x,{changeType:'FEATURE_FLAG_CHANGE',targetRef:'pilot',targetHash,idem:'flag'});assert.throws(()=>x.flags.set({tenantId:'ta',key:'pilot',enabled:true,rolloutPercent:50,actorId:'publisher',traceId:'flag',changeId}),/TARGET_MISMATCH/);const flag=x.flags.set({tenantId:'ta',key:'pilot',enabled:true,rolloutPercent:25,actorId:'publisher',traceId:'flag',changeId});assert.equal(flag.enabled,true);assert.equal(flag.rolloutPercent,25);}finally{x.close();}});
+
+test('V83 retention-policy publish can use the same dual-control change evidence',()=>{const c=controlFixture(),lifecycle=new DataLifecycleRegistry({now:()=>c.now,changeControl:c.changeControl});const draft=lifecycle.createPolicyDraft({tenantId:'ta',policyKey:'MATTER_CONTENT',resourceClass:'MATTER_CONTENT',retentionDays:30,actorId:'requester'});const changeId=approvedChange(c,{changeType:'RETENTION_POLICY_PUBLISH',targetRef:`MATTER_CONTENT@${draft.version}`,targetHash:draft.definitionHash,idem:'retention'});const published=lifecycle.publishPolicy({tenantId:'ta',policyKey:'MATTER_CONTENT',version:draft.version,actorId:'publisher',traceId:'retention-publish',changeId});assert.equal(published.status,'PUBLISHED');});
+
+test('V83 emergency interlock remains independent from normal change approval',async()=>{const {SecurityInterlockRegistry}=await import('../src/securityInterlock.js');const emergency=new SecurityInterlockRegistry({authorizeChange:()=>true});const row=emergency.activate({tenantId:'ta',control:'ALL_EGRESS',actorId:'security-a',traceId:'incident',incidentId:'INC-83',reasonCode:'SUSPECTED_COMPROMISE'});assert.equal(row.status,'ACTIVE');});
