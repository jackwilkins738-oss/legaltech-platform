+import test from 'node:test';import assert from 'node:assert/strict';import {PlatformStore} from '../src/store.js';import {WorkOrchestrator} from '../src/workOrchestration.js';import {WorkAuthorizer} from '../src/workAuthorization.js';import {WorkApiService} from '../src/workApi.js';import {WorkCursorCodec} from '../src/workCursor.js';
+const NOW=Date.parse('2027-02-01T12:00:00Z');
+const ses=({tenantId='ta',actorId='u1',capabilities=['work:read:any'],matterIds=['m1'],securityZoneIds=[],roles=[]}={})=>({tenantId,actorId,capabilities,matterIds,securityZoneIds,roles,status:'ACTIVE'});
+function fixture({now=()=>NOW}={}){const store=new PlatformStore(':memory:',{matters:[{id:'m1',tenantId:'ta',externalId:'1',externalRefs:[]},{id:'m2',tenantId:'tb',externalId:'2',externalRefs:[]}]});const orchestrator=new WorkOrchestrator({store,now});const authorizer=new WorkAuthorizer({store,now});const cursorCodec=new WorkCursorCodec({key:Buffer.alloc(32,7),ttlMs:60_000,now});const api=new WorkApiService({orchestrator,authorizer,cursorCodec});return {store,orchestrator,api,cursorCodec,close:()=>store.close()};}
+function work(x,i,{tenantId='ta',matterId='m1',owner={kind:'USER',id:'u1'},priority=50,requesterId='u1'}={}){return x.orchestrator.createWork({tenantId,matterId,title:`w-${i}`,owner,priority,requesterId,idempotencyKey:`${tenantId}-${i}`,actorId:requesterId,traceId:`t-${i}`});}
+
+test('opaque work cursor does not expose tenant or numeric scan offset',()=>{const x=fixture();try{for(let i=0;i<3;i++)work(x,i);const r=x.api.list({session:ses(),limit:1});assert.equal(r.items.length,1);assert.ok(r.nextCursor);assert.equal(r.nextCursor.includes('ta'),false);assert.equal(/^\d+$/.test(r.nextCursor),false);assert.match(r.nextCursor,/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/);}finally{x.close();}});
+
+test('cursor continues the same queue without duplicate work',()=>{const x=fixture();try{for(let i=0;i<5;i++)work(x,i);const a=x.api.list({session:ses(),limit:2}),b=x.api.list({session:ses(),limit:2,cursor:a.nextCursor});assert.equal(a.items.length,2);assert.equal(b.items.length,2);assert.equal(new Set([...a.items,...b.items].map(v=>v.id)).size,4);}finally{x.close();}});
+
+test('tampered cursor fails closed as invalid request',()=>{const x=fixture();try{for(let i=0;i<2;i++)work(x,i);const a=x.api.list({session:ses(),limit:1}),last=a.nextCursor.at(-1),bad=a.nextCursor.slice(0,-1)+(last==='A'?'B':'A');assert.throws(()=>x.api.list({session:ses(),limit:1,cursor:bad}),e=>e.code==='INVALID_REQUEST'&&e.status===400);}finally{x.close();}});
+
+test('work cursor tenant binding prevents cross-tenant reuse',()=>{const x=fixture();try{for(let i=0;i<2;i++)work(x,i);const a=x.api.list({session:ses(),limit:1});assert.throws(()=>x.api.list({session:ses({tenantId:'tb',actorId:'u2',matterIds:['m2']}),limit:1,cursor:a.nextCursor}),e=>e.code==='INVALID_REQUEST');}finally{x.close();}});
+
+test('work cursor filter binding prevents owner-filter reuse',()=>{const x=fixture();try{for(let i=0;i<3;i++)work(x,i);const a=x.api.list({session:ses(),owner:{kind:'USER',id:'u1'},limit:1});assert.throws(()=>x.api.list({session:ses(),owner:{kind:'ROLE',id:'reviewer'},limit:1,cursor:a.nextCursor}),e=>e.code==='INVALID_REQUEST');}finally{x.close();}});
+
+test('cursor context canonicalises state order but not semantic changes',()=>{const x=fixture();try{for(let i=0;i<3;i++)work(x,i);const a=x.api.list({session:ses(),states:['READY','IN_PROGRESS'],limit:1});const b=x.api.list({session:ses(),states:['IN_PROGRESS','READY'],limit:1,cursor:a.nextCursor});assert.equal(b.items.length,1);assert.throws(()=>x.api.list({session:ses(),states:['READY'],limit:1,cursor:a.nextCursor}),e=>e.code==='INVALID_REQUEST');}finally{x.close();}});
+
+test('expired opaque cursor fails closed',()=>{let clock=NOW;const x=fixture({now:()=>clock});try{for(let i=0;i<2;i++)work(x,i);const a=x.api.list({session:ses(),limit:1});clock+=60_001;assert.throws(()=>x.api.list({session:ses(),limit:1,cursor:a.nextCursor}),e=>e.code==='INVALID_REQUEST');}finally{x.close();}});
+
+test('cursor codec rejects weak key material and excessive TTL',()=>{assert.throws(()=>new WorkCursorCodec({key:Buffer.alloc(16)}),/WORK_CURSOR_KEY_INVALID/);assert.throws(()=>new WorkCursorCodec({key:Buffer.alloc(32),ttlMs:2*60*60*1000}),/WORK_CURSOR_CONFIGURATION_INVALID/);});
+
+test('hidden work does not expose a numeric hidden-record count in pagination',()=>{const x=fixture();try{for(let i=0;i<1001;i++)work(x,i,{matterId:null,owner:{kind:'USER',id:'other'},requesterId:'other'});const s=ses({capabilities:['work:read:self'],matterIds:[]});const r=x.api.list({session:s,limit:1});assert.equal(r.items.length,0);assert.ok(r.nextCursor);assert.equal(/1000/.test(r.nextCursor),false);assert.throws(()=>x.api.list({session:s,limit:1,cursor:'1000'}),e=>e.code==='INVALID_REQUEST');}finally{x.close();}});
