@@ -0,0 +1,45 @@
+// Security regression concepts: published response policy immutable; escalation intent dedupe; escalation event append-only; no automatic reassignment.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {PlatformStore} from '../src/store.js';
+import {WorkOrchestrator} from '../src/workOrchestration.js';
+import {NotificationIntents} from '../src/workflowRuntime.js';
+import {WorkEscalationEngine,validateResponsePolicy} from '../src/workEscalation.js';
+
+function fixture(){let clock=Date.parse('2027-01-10T12:00:00Z');const store=new PlatformStore(':memory:',{matters:[{id:'m1',tenantId:'ta',externalId:'A',externalRefs:[]},{id:'mx',tenantId:'tb',externalId:'X',externalRefs:[]}]});const work=new WorkOrchestrator({store,now:()=>clock});const notifications=new NotificationIntents({store,now:()=>clock});const engine=new WorkEscalationEngine({store,workOrchestrator:work,notificationIntents:notifications,now:()=>clock});return {store,work,notifications,engine,advance:ms=>clock+=ms,close:()=>store.close()};}
+const notifyDef=(more={})=>({clock:'CREATED_AT',thresholdMs:60000,action:'NOTIFY_OWNER',selector:{types:['DECISION'],states:['READY'],ownerKinds:['USER']},channel:'IN_APP',severity:'NORMAL',...more});
+const escalationDef=(more={})=>({clock:'WAITING_SINCE',thresholdMs:60000,action:'CREATE_ESCALATION',selector:{states:['WAITING_INTERNAL']},target:{kind:'TEAM',id:'supervisor-pool'},...more});
+function publish(x,key='RESP_1',definition=notifyDef()){const d=x.engine.createDraft({tenantId:'ta',policyKey:key,name:'Response target',definition,actorId:'ops',traceId:'draft'});return x.engine.publish({tenantId:'ta',policyKey:key,version:d.version,actorId:'ops',traceId:'publish'});}
+function decision(x,key='w1',more={}){return x.work.createRequest({tenantId:'ta',matterId:'m1',type:'DECISION',title:'Decision needed',requesterId:'admin',owner:{kind:'USER',id:'manager'},idempotencyKey:key,actorId:'admin',traceId:key,...more});}
+
+test('response policy validates bounded selectors clocks thresholds and actions',()=>{assert.equal(validateResponsePolicy(notifyDef()).action,'NOTIFY_OWNER');assert.throws(()=>validateResponsePolicy(notifyDef({clock:'MAGIC'})),/POLICY_INVALID/);assert.throws(()=>validateResponsePolicy(notifyDef({thresholdMs:31*24*60*60*1000})),/THRESHOLD_INVALID/);assert.throws(()=>validateResponsePolicy({...notifyDef(),selector:{types:['NOPE']}}),/TYPES_INVALID/);});
+
+test('notification policy cannot smuggle a reassignment target',()=>{assert.throws(()=>validateResponsePolicy({...notifyDef(),target:{kind:'USER',id:'boss'}}),/TARGET_INVALID/);});
+
+test('escalation-work policy requires a valid generic owner target',()=>{assert.equal(validateResponsePolicy(escalationDef()).target.kind,'TEAM');assert.throws(()=>validateResponsePolicy({...escalationDef(),target:null}),/OWNER_INVALID/);});
+
+test('published policy is content-hash pinned and cannot be edited through storage',()=>{const x=fixture();try{const p=publish(x);assert.equal(p.status,'PUBLISHED');assert.throws(()=>x.store.db.prepare("UPDATE response_policies SET definition_hash='evil'").run(),/response policy transition invalid/);}finally{x.close();}});
+
+test('versioned response policies retain old published behavior while a new draft exists',()=>{const x=fixture();try{const p1=publish(x);const d2=x.engine.createDraft({tenantId:'ta',policyKey:'RESP_1',name:'Response target v2',definition:notifyDef({thresholdMs:120000}),actorId:'ops',traceId:'d2',basedOnVersion:1});assert.equal(p1.version,1);assert.equal(d2.version,2);assert.equal(x.store.latestPublishedResponsePolicy('ta','RESP_1').version,1);}finally{x.close();}});
+
+test('created-at threshold does nothing before target and creates intent after target',()=>{const x=fixture();try{publish(x);decision(x);assert.equal(x.engine.evaluate({tenantId:'ta',policyKey:'RESP_1',actorId:'ops',traceId:'e1'}).eligible,0);x.advance(60000);const r=x.engine.evaluate({tenantId:'ta',policyKey:'RESP_1',actorId:'ops',traceId:'e2'});assert.equal(r.eligible,1);assert.equal(r.intents[0].action,'NOTIFY_OWNER');}finally{x.close();}});
+
+test('notification escalation creates intent only through bounded notification queue',()=>{const x=fixture();try{publish(x);decision(x);x.advance(60000);const i=x.engine.evaluate({tenantId:'ta',policyKey:'RESP_1',actorId:'ops',traceId:'e'}).intents[0];const n=x.store.getNotificationIntent('ta',i.notificationIntentId);assert.equal(n.status,'QUEUED');assert.equal(n.channel,'IN_APP');assert.deepEqual(n.recipient,{kind:'USER',id:'manager'});assert.equal(i.escalationWorkId,null);}finally{x.close();}});
+
+test('policy evaluation is deduplicated for the same policy version and source work',()=>{const x=fixture();try{publish(x);decision(x);x.advance(60000);const a=x.engine.evaluate({tenantId:'ta',policyKey:'RESP_1',actorId:'ops',traceId:'e1'}),b=x.engine.evaluate({tenantId:'ta',policyKey:'RESP_1',actorId:'ops',traceId:'e2'});assert.equal(a.intents[0].id,b.intents[0].id);assert.equal(b.intents[0].replayed,true);assert.equal(x.engine.listIntents({tenantId:'ta'}).length,1);}finally{x.close();}});
+
+test('selectors prevent unrelated work types owners and states from triggering',()=>{const x=fixture();try{publish(x);x.work.createWork({tenantId:'ta',matterId:'m1',type:'TASK',title:'Task',requesterId:'a',owner:{kind:'USER',id:'manager'},idempotencyKey:'t',actorId:'a',traceId:'t'});decision(x,'d',{owner:{kind:'TEAM',id:'managers'}});x.advance(60000);assert.equal(x.engine.evaluate({tenantId:'ta',policyKey:'RESP_1',actorId:'ops',traceId:'e'}).eligible,0);}finally{x.close();}});
+
+test('waiting-since policy creates an explicit escalation work item without reassigning source',()=>{const x=fixture();try{publish(x,'WAIT_1',escalationDef());let source=decision(x);source=x.work.transition({tenantId:'ta',workId:source.id,to:'WAITING_INTERNAL',expectedVersion:1,actorId:'manager',traceId:'w',reason:'needs senior input'});x.advance(60000);const i=x.engine.evaluate({tenantId:'ta',policyKey:'WAIT_1',actorId:'ops',traceId:'e'}).intents[0],escalation=x.work.getWork('ta',i.escalationWorkId),unchanged=x.work.getWork('ta',source.id);assert.equal(escalation.type,'ESCALATION');assert.deepEqual(escalation.owner,{kind:'TEAM',id:'supervisor-pool'});assert.equal(escalation.metadata.escalationGenerated,true);assert.deepEqual(unchanged.owner,{kind:'USER',id:'manager'});}finally{x.close();}});
+
