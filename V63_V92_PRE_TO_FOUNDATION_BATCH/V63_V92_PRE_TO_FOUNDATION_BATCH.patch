@@ -0,0 +1,63 @@
+BEGIN;
+
+-- V63: durable, tenant-bound, append-only recovery evidence. This records recovery
+-- control evidence; backup bytes remain in an external managed immutable backup plane.
+CREATE TABLE IF NOT EXISTS recovery_evidence (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  event_type text NOT NULL CHECK (event_type IN ('BACKUP_VERIFIED','RESTORE_AUTHORIZED','RESTORE_STARTED','RESTORE_VERIFIED','RECOVERY_DRILL')),
+  backup_id text NOT NULL,
+  backup_set_id text NOT NULL,
+  generation bigint NOT NULL CHECK (generation > 0),
+  manifest_hash text NOT NULL CHECK (manifest_hash ~ '^[a-f0-9]{64}$'),
+  restore_id uuid,
+  actor_id uuid,
+  approver_id uuid,
+  target_environment text,
+  outcome text NOT NULL,
+  reason_code text NOT NULL,
+  trace_id text NOT NULL,
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  previous_hash text,
+  entry_hash text,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id, actor_id) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id, approver_id) REFERENCES actors(tenant_id,id),
+  CHECK (actor_id IS NULL OR approver_id IS NULL OR actor_id <> approver_id)
+);
+CREATE INDEX IF NOT EXISTS idx_recovery_evidence_tenant_time ON recovery_evidence(tenant_id, occurred_at DESC);
+CREATE INDEX IF NOT EXISTS idx_recovery_backup ON recovery_evidence(tenant_id, backup_id, generation);
+CREATE UNIQUE INDEX IF NOT EXISTS idx_recovery_restore_event ON recovery_evidence(tenant_id, restore_id, event_type) WHERE restore_id IS NOT NULL;
+
+CREATE OR REPLACE FUNCTION chain_recovery_evidence() RETURNS trigger
+LANGUAGE plpgsql AS $$
+DECLARE prior text; material text;
+BEGIN
+  PERFORM pg_advisory_xact_lock(hashtext(NEW.tenant_id::text));
+  SELECT entry_hash INTO prior FROM recovery_evidence
+    WHERE tenant_id=NEW.tenant_id AND entry_hash IS NOT NULL ORDER BY id DESC LIMIT 1;
+  NEW.previous_hash := COALESCE(prior, repeat('0',64));
+  material := concat_ws('|',NEW.previous_hash,NEW.tenant_id::text,NEW.event_type,NEW.backup_id,
+    NEW.backup_set_id,NEW.generation::text,NEW.manifest_hash,COALESCE(NEW.restore_id::text,''),
+    COALESCE(NEW.actor_id::text,''),COALESCE(NEW.approver_id::text,''),COALESCE(NEW.target_environment,''),
+    NEW.outcome,NEW.reason_code,NEW.trace_id,NEW.evidence::text,NEW.occurred_at::text);
+  NEW.entry_hash := encode(digest(material,'sha256'),'hex');
+  RETURN NEW;
+END;
+$$;
+DROP TRIGGER IF EXISTS recovery_evidence_hash_chain ON recovery_evidence;
+CREATE TRIGGER recovery_evidence_hash_chain BEFORE INSERT ON recovery_evidence
+FOR EACH ROW EXECUTE FUNCTION chain_recovery_evidence();
+
+CREATE OR REPLACE FUNCTION deny_recovery_evidence_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'recovery evidence is append-only'; END; $$;
+DROP TRIGGER IF EXISTS recovery_evidence_append_only ON recovery_evidence;
+CREATE TRIGGER recovery_evidence_append_only BEFORE UPDATE OR DELETE ON recovery_evidence
+FOR EACH ROW EXECUTE FUNCTION deny_recovery_evidence_mutation();
+
+ALTER TABLE recovery_evidence ENABLE ROW LEVEL SECURITY;
+ALTER TABLE recovery_evidence FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_recovery_evidence_read ON recovery_evidence FOR SELECT USING (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_recovery_evidence_insert ON recovery_evidence FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id());
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/009_work_orchestration.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/009_work_orchestration.sql
new file mode 100644
index 0000000..5d26e98
--- /dev/null
+++ b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/009_work_orchestration.sql
@@ -0,0 +1,93 @@
+BEGIN;
+
+-- V64: generic pre-TO work orchestration primitives. These deliberately avoid
+-- practice-area or firm-specific workflow assumptions.
+CREATE TABLE work_items (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  matter_id uuid,
+  work_type text NOT NULL CHECK (work_type IN ('TASK','QUESTION','DECISION','REVIEW','APPROVAL','HANDOFF','ESCALATION')),
+  state text NOT NULL DEFAULT 'READY' CHECK (state IN ('READY','IN_PROGRESS','WAITING_INTERNAL','WAITING_EXTERNAL','BLOCKED','REVIEW','COMPLETED','CANCELLED')),
+  title text NOT NULL CHECK (length(title) BETWEEN 1 AND 300),
+  description text,
+  requester_actor_id uuid NOT NULL,
+  owner_kind text NOT NULL CHECK (owner_kind IN ('USER','ROLE','TEAM','POOL')),
+  owner_actor_id uuid,
+  owner_ref text,
+  priority integer NOT NULL DEFAULT 50 CHECK (priority BETWEEN 0 AND 100),
+  due_at timestamptz,
+  version bigint NOT NULL DEFAULT 1 CHECK (version > 0),
+  waiting_since timestamptz,
+  reactivated_at timestamptz,
+  completed_at timestamptz,
+  cancelled_at timestamptz,
+  response jsonb,
+  metadata jsonb NOT NULL DEFAULT '{}'::jsonb,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (tenant_id,id),
+  FOREIGN KEY (tenant_id,matter_id) REFERENCES matters(tenant_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (tenant_id,requester_actor_id) REFERENCES actors(tenant_id,id),
+  FOREIGN KEY (tenant_id,owner_actor_id) REFERENCES actors(tenant_id,id),
+  CHECK ((owner_kind='USER' AND owner_actor_id IS NOT NULL AND owner_ref IS NULL) OR (owner_kind<>'USER' AND owner_actor_id IS NULL AND owner_ref IS NOT NULL))
+);
+CREATE INDEX idx_work_queue ON work_items(tenant_id,state,owner_kind,priority DESC,due_at);
+CREATE INDEX idx_work_matter ON work_items(tenant_id,matter_id,state);
+
+CREATE TABLE work_dependencies (
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  work_id uuid NOT NULL,
+  depends_on_work_id uuid NOT NULL,
+  status text NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE','RESOLVED')),
+  created_by uuid NOT NULL,
+  reason text NOT NULL,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  resolved_at timestamptz,
+  PRIMARY KEY (tenant_id,work_id,depends_on_work_id),
+  FOREIGN KEY (tenant_id,work_id) REFERENCES work_items(tenant_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (tenant_id,depends_on_work_id) REFERENCES work_items(tenant_id,id),
+  FOREIGN KEY (tenant_id,created_by) REFERENCES actors(tenant_id,id),
+  CHECK (work_id <> depends_on_work_id)
+);
+CREATE INDEX idx_work_dependencies_blocker ON work_dependencies(tenant_id,depends_on_work_id,status);
+
+CREATE TABLE work_events (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  work_id uuid NOT NULL,
+  matter_id uuid,
+  event_type text NOT NULL,
+  actor_id uuid NOT NULL,
+  trace_id text NOT NULL,
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,work_id) REFERENCES work_items(tenant_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (tenant_id,matter_id) REFERENCES matters(tenant_id,id),
+  FOREIGN KEY (tenant_id,actor_id) REFERENCES actors(tenant_id,id)
+);
+CREATE INDEX idx_work_events_work ON work_events(tenant_id,work_id,id);
+
+ALTER TABLE work_items ENABLE ROW LEVEL SECURITY;
+ALTER TABLE work_items FORCE ROW LEVEL SECURITY;
+ALTER TABLE work_dependencies ENABLE ROW LEVEL SECURITY;
+ALTER TABLE work_dependencies FORCE ROW LEVEL SECURITY;
+ALTER TABLE work_events ENABLE ROW LEVEL SECURITY;
+ALTER TABLE work_events FORCE ROW LEVEL SECURITY;
+
+CREATE POLICY tenant_and_matter_work_items ON work_items
+  USING (tenant_id=app_current_tenant_id() AND (matter_id IS NULL OR EXISTS (SELECT 1 FROM matters m WHERE m.tenant_id=work_items.tenant_id AND m.id=work_items.matter_id)))
+  WITH CHECK (tenant_id=app_current_tenant_id() AND (matter_id IS NULL OR EXISTS (SELECT 1 FROM matters m WHERE m.tenant_id=work_items.tenant_id AND m.id=work_items.matter_id)));
+CREATE POLICY tenant_work_dependencies ON work_dependencies
+  USING (tenant_id=app_current_tenant_id() AND EXISTS (SELECT 1 FROM work_items w WHERE w.tenant_id=work_dependencies.tenant_id AND w.id=work_dependencies.work_id))
+  WITH CHECK (tenant_id=app_current_tenant_id() AND EXISTS (SELECT 1 FROM work_items w WHERE w.tenant_id=work_dependencies.tenant_id AND w.id=work_dependencies.work_id) AND EXISTS (SELECT 1 FROM work_items b WHERE b.tenant_id=work_dependencies.tenant_id AND b.id=work_dependencies.depends_on_work_id));
+CREATE POLICY tenant_work_events_read ON work_events FOR SELECT
+  USING (tenant_id=app_current_tenant_id() AND EXISTS (SELECT 1 FROM work_items w WHERE w.tenant_id=work_events.tenant_id AND w.id=work_events.work_id));
+CREATE POLICY tenant_work_events_insert ON work_events FOR INSERT
+  WITH CHECK (tenant_id=app_current_tenant_id() AND EXISTS (SELECT 1 FROM work_items w WHERE w.tenant_id=work_events.tenant_id AND w.id=work_events.work_id));
+
+CREATE OR REPLACE FUNCTION deny_work_event_mutation() RETURNS trigger
+LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'work_events are append-only'; END; $$;
+CREATE TRIGGER work_events_append_only BEFORE UPDATE OR DELETE ON work_events
+FOR EACH ROW EXECUTE FUNCTION deny_work_event_mutation();
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/010_workflow_runtime.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/010_workflow_runtime.sql
new file mode 100644
index 0000000..aed52b5
--- /dev/null
+++ b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/010_workflow_runtime.sql
@@ -0,0 +1,127 @@
+BEGIN;
+
+-- V65: versioned workflow execution, tenant feature flags and notification intents.
+-- Runtime definitions are generic and cannot directly execute Graph/Proclaim writes.
+CREATE TABLE workflow_definitions (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  workflow_key text NOT NULL,
+  version integer NOT NULL CHECK (version > 0),
+  status text NOT NULL CHECK (status IN ('DRAFT','PUBLISHED','RETIRED')),
+  name text NOT NULL,
+  definition_hash text NOT NULL CHECK (definition_hash ~ '^[a-f0-9]{64}$'),
+  definition jsonb NOT NULL,
+  based_on_version integer,
+  created_by uuid NOT NULL,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  published_at timestamptz,
+  retired_at timestamptz,
+  UNIQUE (tenant_id,id),
+  UNIQUE (tenant_id,workflow_key,version),
+  FOREIGN KEY (tenant_id,created_by) REFERENCES actors(tenant_id,id)
+);
+
+CREATE TABLE workflow_instances (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  workflow_definition_id uuid NOT NULL,
+  workflow_key text NOT NULL,
+  workflow_version integer NOT NULL,
+  definition_hash text NOT NULL CHECK (definition_hash ~ '^[a-f0-9]{64}$'),
+  matter_id uuid,
+  state text NOT NULL CHECK (state IN ('RUNNING','WAITING','COMPLETED','FAILED','CANCELLED')),
+  current_step_id text,
+  context jsonb NOT NULL DEFAULT '{}'::jsonb,
+  waiting jsonb,
+  step_count integer NOT NULL DEFAULT 0 CHECK (step_count BETWEEN 0 AND 100),
+  version bigint NOT NULL DEFAULT 1 CHECK (version > 0),
+  created_by uuid NOT NULL,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  completed_at timestamptz,
+  error_code text,
+  UNIQUE (tenant_id,id),
+  FOREIGN KEY (tenant_id,workflow_definition_id) REFERENCES workflow_definitions(tenant_id,id),
+  FOREIGN KEY (tenant_id,matter_id) REFERENCES matters(tenant_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (tenant_id,created_by) REFERENCES actors(tenant_id,id)
+);
+CREATE INDEX idx_workflow_instances_queue ON workflow_instances(tenant_id,state,workflow_key,updated_at);
+
+CREATE TABLE workflow_events (
+  id bigserial PRIMARY KEY,
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  workflow_instance_id uuid NOT NULL,
+  matter_id uuid,
+  event_type text NOT NULL,
+  actor_id uuid NOT NULL,
+  trace_id text NOT NULL,
+  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,workflow_instance_id) REFERENCES workflow_instances(tenant_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (tenant_id,matter_id) REFERENCES matters(tenant_id,id),
+  FOREIGN KEY (tenant_id,actor_id) REFERENCES actors(tenant_id,id)
+);
+
+CREATE TABLE feature_flags (
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  flag_key text NOT NULL,
+  enabled boolean NOT NULL DEFAULT false,
+  rollout_percent integer NOT NULL DEFAULT 100 CHECK (rollout_percent BETWEEN 0 AND 100),
+  version bigint NOT NULL DEFAULT 1 CHECK (version > 0),
+  updated_by uuid NOT NULL,
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (tenant_id,flag_key),
+  FOREIGN KEY (tenant_id,updated_by) REFERENCES actors(tenant_id,id)
+);
+
+CREATE TABLE notification_intents (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES tenants(id),
+  channel text NOT NULL CHECK (channel IN ('IN_APP','TEAMS')),
+  template_id text NOT NULL,
+  recipient_kind text NOT NULL CHECK (recipient_kind IN ('USER','ROLE','TEAM','POOL')),
+  recipient_actor_id uuid,
+  recipient_ref text,
+  object_type text NOT NULL,
+  object_id text NOT NULL,
+  dedupe_key text NOT NULL,
+  severity text NOT NULL CHECK (severity IN ('LOW','NORMAL','HIGH','CRITICAL')),
+  status text NOT NULL CHECK (status IN ('QUEUED','SENDING','DELIVERED','DEAD')),
+  attempts integer NOT NULL DEFAULT 0 CHECK (attempts BETWEEN 0 AND 3),
+  trace_id text NOT NULL,
+  expires_at timestamptz,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  delivered_at timestamptz,
+  last_error text,
+  UNIQUE (tenant_id,id),
+  UNIQUE (tenant_id,dedupe_key),
+  FOREIGN KEY (tenant_id,recipient_actor_id) REFERENCES actors(tenant_id,id),
+  CHECK ((recipient_kind='USER' AND recipient_actor_id IS NOT NULL AND recipient_ref IS NULL) OR (recipient_kind<>'USER' AND recipient_actor_id IS NULL AND recipient_ref IS NOT NULL))
+);
+CREATE INDEX idx_notification_intents_queue ON notification_intents(tenant_id,status,channel,created_at);
+
+ALTER TABLE workflow_definitions ENABLE ROW LEVEL SECURITY; ALTER TABLE workflow_definitions FORCE ROW LEVEL SECURITY;
+ALTER TABLE workflow_instances ENABLE ROW LEVEL SECURITY; ALTER TABLE workflow_instances FORCE ROW LEVEL SECURITY;
+ALTER TABLE workflow_events ENABLE ROW LEVEL SECURITY; ALTER TABLE workflow_events FORCE ROW LEVEL SECURITY;
+ALTER TABLE feature_flags ENABLE ROW LEVEL SECURITY; ALTER TABLE feature_flags FORCE ROW LEVEL SECURITY;
+ALTER TABLE notification_intents ENABLE ROW LEVEL SECURITY; ALTER TABLE notification_intents FORCE ROW LEVEL SECURITY;
+
+CREATE POLICY tenant_workflow_definitions ON workflow_definitions USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_workflow_instances ON workflow_instances USING (tenant_id=app_current_tenant_id() AND (matter_id IS NULL OR EXISTS (SELECT 1 FROM matters m WHERE m.tenant_id=workflow_instances.tenant_id AND m.id=workflow_instances.matter_id))) WITH CHECK (tenant_id=app_current_tenant_id() AND (matter_id IS NULL OR EXISTS (SELECT 1 FROM matters m WHERE m.tenant_id=workflow_instances.tenant_id AND m.id=workflow_instances.matter_id)));
+CREATE POLICY tenant_workflow_events_read ON workflow_events FOR SELECT USING (tenant_id=app_current_tenant_id() AND EXISTS (SELECT 1 FROM workflow_instances w WHERE w.tenant_id=workflow_events.tenant_id AND w.id=workflow_events.workflow_instance_id));
+CREATE POLICY tenant_workflow_events_insert ON workflow_events FOR INSERT WITH CHECK (tenant_id=app_current_tenant_id() AND EXISTS (SELECT 1 FROM workflow_instances w WHERE w.tenant_id=workflow_events.tenant_id AND w.id=workflow_events.workflow_instance_id));
+CREATE POLICY tenant_feature_flags ON feature_flags USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+CREATE POLICY tenant_notification_intents ON notification_intents USING (tenant_id=app_current_tenant_id()) WITH CHECK (tenant_id=app_current_tenant_id());
+
+CREATE OR REPLACE FUNCTION protect_published_workflow_definition() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  IF OLD.status IN ('PUBLISHED','RETIRED') AND (NEW.definition IS DISTINCT FROM OLD.definition OR NEW.definition_hash IS DISTINCT FROM OLD.definition_hash OR NEW.workflow_key IS DISTINCT FROM OLD.workflow_key OR NEW.version IS DISTINCT FROM OLD.version) THEN RAISE EXCEPTION 'published workflow definition is immutable'; END IF;
+  RETURN NEW;
+END; $$;
+CREATE TRIGGER workflow_definition_immutable BEFORE UPDATE ON workflow_definitions FOR EACH ROW EXECUTE FUNCTION protect_published_workflow_definition();
+
+CREATE OR REPLACE FUNCTION deny_workflow_event_mutation() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'workflow_events are append-only'; END; $$;
+CREATE TRIGGER workflow_events_append_only BEFORE UPDATE OR DELETE ON workflow_events FOR EACH ROW EXECUTE FUNCTION deny_workflow_event_mutation();
+
+COMMIT;
diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/011_to_evidence.sql b/30_PRODUCTION_SHAPE_SCAFFOLD/db/migrations/011_to_evidence.sql
new file mode 100644
