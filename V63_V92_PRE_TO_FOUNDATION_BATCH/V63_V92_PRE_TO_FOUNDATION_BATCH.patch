+
+test('V88 support capability alone never grants matter access',()=>{const r=new JitSupportAccessRegistry({now:()=>NOW});assert.throws(()=>r.assertMatterRead(requester(),{matterId:'m1',traceId:'tr'}),/SUPPORT_ACCESS_UNAVAILABLE/);});
+test('V88 request requires recent step-up and explicit request capability',()=>{const r=new JitSupportAccessRegistry({now:()=>NOW});assert.throws(()=>r.request({session:session('a',[]),scope:'MATTER_READ',matterId:'m1',ticketRef:'SUP-1',purpose:'Investigate client issue safely',traceId:'t'}));assert.throws(()=>r.request({session:session('a',['support:access:request'],{authContext:{method:'SERVER_SESSION',mfaVerified:false,authTime:'2027-04-01T11:59:00Z',expiresAt:'2027-04-01T13:00:00Z',providerSessionId:'p'}}),scope:'MATTER_READ',matterId:'m1',ticketRef:'SUP-1',purpose:'Investigate client issue safely',traceId:'t'}),e=>e?.code==='STEP_UP_REQUIRED');});
+test('V88 approval requires a different stepped-up actor',()=>{const r=new JitSupportAccessRegistry({now:()=>NOW});const q=request(r);assert.throws(()=>r.approve({session:session('support-a',['support:access:approve']),requestId:q.requestId,traceId:'tr-a'}),/DUAL_CONTROL/);const g=r.approve({session:approver(),requestId:q.requestId,traceId:'tr-b'});assert.equal(g.status,'ACTIVE');assert.equal(g.approverId,'security-b');});
+test('V88 grant is tenant actor matter and scope bound',()=>{const r=new JitSupportAccessRegistry({now:()=>NOW});const q=request(r);r.approve({session:approver(),requestId:q.requestId,traceId:'a'});assert.equal(r.assertMatterRead(requester(),{matterId:'m1',traceId:'use'}).requestId,q.requestId);assert.throws(()=>r.assertMatterRead(requester(),{matterId:'m2',traceId:'x'}),/UNAVAILABLE/);assert.throws(()=>r.assertMatterRead(session('support-x',[]),{matterId:'m1',traceId:'x'}),/UNAVAILABLE/);assert.throws(()=>r.assertMatterRead(session('support-a',['support:access:request'],{tenantId:'tb'}),{matterId:'m1',traceId:'x'}),/UNAVAILABLE/);});
+test('V88 document grants cannot expand into matter or other document access',()=>{const r=new JitSupportAccessRegistry({now:()=>NOW});const q=request(r,{scope:'DOCUMENT_READ',documentRef:'doc-1'});r.approve({session:approver(),requestId:q.requestId,traceId:'a'});assert.equal(r.assertDocumentRead(requester(),{matterId:'m1',documentRef:'doc-1',traceId:'u'}).requestId,q.requestId);assert.throws(()=>r.assertDocumentRead(requester(),{matterId:'m1',documentRef:'doc-2',traceId:'x'}),/UNAVAILABLE/);assert.throws(()=>r.assertMatterRead(requester(),{matterId:'m1',traceId:'x'}),/UNAVAILABLE/);});
+test('V88 expiry and revocation fail access closed',()=>{let now=NOW;const r=new JitSupportAccessRegistry({now:()=>now,ttlSeconds:60});let q=request(r);r.approve({session:approver(),requestId:q.requestId,traceId:'a'});now+=60_001;assert.equal(r.status({tenantId:'ta',requestId:q.requestId}).status,'EXPIRED');assert.throws(()=>r.assertMatterRead(session('support-a',['support:access:request'],{authContext:{method:'SERVER_SESSION',mfaVerified:true,authTime:new Date(now-1_000).toISOString(),expiresAt:new Date(now+60_000).toISOString(),providerSessionId:'p'}}),{matterId:'m1',traceId:'x'}),/UNAVAILABLE/);now=NOW;const r2=new JitSupportAccessRegistry({now:()=>now});q=request(r2);r2.approve({session:approver(),requestId:q.requestId,traceId:'a'});r2.revoke({session:revoker(),requestId:q.requestId,traceId:'r',reason:'Incident resolved and access no longer required'});assert.equal(r2.status({tenantId:'ta',requestId:q.requestId}).status,'REVOKED');assert.throws(()=>r2.assertMatterRead(requester(),{matterId:'m1',traceId:'x'}),/UNAVAILABLE/);});
