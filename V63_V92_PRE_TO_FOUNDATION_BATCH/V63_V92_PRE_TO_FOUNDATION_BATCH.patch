diff --git a/30_PRODUCTION_SHAPE_SCAFFOLD/docs/V63_RECOVERY_RESILIENCE.md b/30_PRODUCTION_SHAPE_SCAFFOLD/docs/V63_RECOVERY_RESILIENCE.md
