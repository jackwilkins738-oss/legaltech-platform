+
+test('metrics expose current wait, overdue count and request response latency',()=>{const x=fixture({now:Date.parse('2027-01-10T00:00:00Z')});try{let a=x.work.createWork(base({idempotencyKey:'1',dueAt:'2027-01-09T00:00:00Z'}));const q=x.work.createRequest(base({idempotencyKey:'2',type:'DECISION',title:'decision'}));a=x.work.transition({tenantId:'ta',workId:a.id,to:'WAITING_INTERNAL',expectedVersion:1,actorId:'u1',traceId:'w',reason:'waiting'});x.advance(10_000);x.work.respond({tenantId:'ta',workId:q.id,expectedVersion:1,actorId:'u2',traceId:'r',outcome:'OK'});const m=x.work.metrics({tenantId:'ta'});assert.equal(m.total,2);assert.equal(m.byState.WAITING_INTERNAL,1);assert.equal(m.overdue,1);assert.equal(m.internalWaitingMs,10_000);assert.equal(m.requestsCompleted,1);assert.equal(m.averageResponseLatencyMs,10_000);}finally{x.close();}});
