+test('V89 change and lifecycle semantics are mutually exclusive and bounded',async()=>{for(const bad of [note({changeType:null,lifecycleEvent:null}),note({lifecycleEvent:'missed'}),note({changeType:'bogus'})])await assert.rejects(()=>accepted(ingress(),{value:[bad]}),/INVALID/);const rows=await accepted(ingress(),{value:[note({changeType:undefined,lifecycleEvent:'missed'})]});assert.equal(rows[0].lifecycleEvent,'missed');});
+test('V89 duplicates are identified by server fingerprint and are not a second dispatch',async()=>{const g=ingress();const a=await accepted(g),b=await accepted(g);assert.equal(a[0].duplicate,false);assert.equal(b[0].duplicate,true);assert.equal(a[0].notificationFingerprint,b[0].notificationFingerprint);});
+test('V89 rich notifications require verified tenant/app/caller token claims',async()=>{const sub=baseSub({richData:true});const good=ingress(sub,{verifyValidationTokens:async()=>[{directoryTenantId:DIR,appId:APP,callerAppId:GRAPH_CHANGE_NOTIFICATION_CALLER_APP_ID}]});assert.equal((await accepted(good,{value:[note()],validationTokens:['verified.jwt.token.value']}))[0].duplicate,false);for(const claims of [[{directoryTenantId:DIR,appId:APP,callerAppId:'44444444-4444-4444-8444-444444444444'}],[{directoryTenantId:DIR,appId:'55555555-5555-4555-8555-555555555555',callerAppId:GRAPH_CHANGE_NOTIFICATION_CALLER_APP_ID}]]){const bad=ingress(sub,{verifyValidationTokens:async()=>claims});await assert.rejects(()=>accepted(bad,{value:[note()],validationTokens:['verified.jwt.token.value']}),/TOKEN_INVALID/);}});
