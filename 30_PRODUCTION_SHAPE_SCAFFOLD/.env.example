NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://legaltech:change-me@localhost:5432/legaltech
AUTH_MODE=mock
OIDC_ISSUER=https://login.microsoftonline.com/replace-tenant-id/v2.0
OIDC_AUDIENCE=api://replace-legaltech-api-id
OIDC_JWKS_URI=https://login.microsoftonline.com/replace-tenant-id/discovery/v2.0/keys
OIDC_ALLOWED_DIRECTORY_TENANTS=replace-tenant-id
PUBLIC_ORIGIN=https://legaltech.example.invalid
SESSION_ABSOLUTE_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=30
LOG_LEVEL=info
OBJECT_STORAGE_MODE=local
QUEUE_MODE=local
SESSION_STORE_MODE=local
RATE_LIMIT_MODE=local
AUDIT_SINK_MODE=local
SECRET_STORE_MODE=local
DATABASE_ROLE_MODE=development-owner
# Production must use AUTH_MODE=oidc, an HTTPS OIDC_ISSUER, a managed secret store,
# non-local object storage/queue and DATABASE_ROLE_MODE=restricted-runtime.
# ALLOW_REAL_CLIENT_DATA must remain false until every production evidence gate passes.
ALLOW_REAL_CLIENT_DATA=false
# Never commit real secrets.

# Evidence gates are intentionally false/pending by default. Environment values are only
# interlocks; production approval requires reviewed artefacts outside this file.
PRODUCTION_SECURITY_APPROVED=false
INDEPENDENT_PEN_TEST_STATUS=PENDING
SESSION_REVOCATION_STATUS=PENDING
OIDC_STEP_UP_STATUS=PENDING
SECRETS_KMS_STATUS=PENDING
NETWORK_ISOLATION_STATUS=PENDING
MONITORING_STATUS=PENDING
AUDIT_EXPORT_STATUS=PENDING
BACKUP_ENCRYPTION_STATUS=PENDING
RESTORE_TEST_STATUS=PENDING
MALWARE_SCAN_MODE=disabled
PARSER_ISOLATION_MODE=disabled
QUARANTINE_STORAGE_MODE=disabled
DOCUMENT_SECURITY_PIPELINE_STATUS=PENDING
GRAPH_LIVE_VALIDATED=false
PROCLAIM_LIVE_VALIDATED=false

# V61 production connector credential containment. Production must use a managed
# secret store reached with workload/federated identity. Connector secrets are
# resolved only through the broker, are not cached as plaintext and must use
# least-privilege provider identities.
SECRET_STORE_AUTH_MODE=local
CONNECTOR_CREDENTIAL_MODE=local
CONNECTOR_SECRET_CACHE_MODE=local
GRAPH_CREDENTIAL_SCOPE_MODE=local
PROCLAIM_CREDENTIAL_SCOPE_MODE=local
CONNECTOR_CREDENTIAL_ROTATION_STATUS=PENDING
CONNECTOR_CREDENTIAL_REVOCATION_STATUS=PENDING
CONNECTOR_SECRET_AUDIT_STATUS=PENDING
CONNECTOR_CREDENTIAL_GENERATION_STORE_MODE=local
CONNECTOR_CREDENTIAL_GENERATION_STORE_STATUS=PENDING
